+/* --- Màn hình chờ thời tiết (weather idle screen) --- */
+static lv_obj_t *s_wx_panel;    /* overlay toàn màn hình, mặc định ẩn */
+static lv_obj_t *s_wx_place;
+static lv_obj_t *s_wx_clock;
