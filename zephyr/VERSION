# The firmware version, MAJOR.MINOR.PATCH: set here only.
# cmake/mg_version.cmake turns it into what the gadget reports: 0.2.0 for a
# build of the release tag xn54-v0.2.0, 0.2.0-dev.N+SHA for anything else
# (MCUboot image 0.2.0+N), so no two images share a version. VERSION_TWEAK
# and EXTRAVERSION stay as they are: the build number comes from git.
VERSION_MAJOR = 0
VERSION_MINOR = 2
PATCHLEVEL = 0
VERSION_TWEAK = 0
EXTRAVERSION =
