mainmenu "Muse Gadget (Zephyr)"

rsource "Kconfig.mg"
# A board's own app code, in a directory beside the app (its app_ext.cmake,
# CMakeLists.txt), may bring its own options in a Kconfig.ext.
orsource "*/Kconfig.ext"

# The controller's side of the link this app asks for (prj.conf): defaults
# here, not assignments, so they apply only where the controller is built
# into this image.
config BT_CTLR_DATA_LENGTH_MAX
	default 251

config BT_CTLR_PHY_2M
	default y

# Device Information Service strings (mgcommands.h). The firmware revision
# is the version cmake/mg_version.cmake works out from VERSION and git;
# the MCUboot image version comes from the same place.
config BT_DIS_FW_REV_STR
	default "$(MG_FW_VERSION)"

if BOOTLOADER_MCUBOOT
config MCUBOOT_IMGTOOL_SIGN_VERSION
	default "$(MG_IMAGE_VERSION)"
endif

config BT_DIS_MANUF_NAME_STR
	default "Seeed Studio"

config BT_DIS_MODEL_NUMBER_STR
	default "XIAO nRF54L15"

config BT_DIS_SW_REV_STR
	default "mg1"

# The connection parameters GAP advertises (Peripheral Preferred Connection
# Parameters) are the ones mg_connparam.c asks for.
config BT_PERIPHERAL_PREF_MIN_INT
	default MG_CONN_INTERVAL_MIN

config BT_PERIPHERAL_PREF_MAX_INT
	default MG_CONN_INTERVAL_MAX

config BT_PERIPHERAL_PREF_LATENCY
	default MG_CONN_LATENCY

config BT_PERIPHERAL_PREF_TIMEOUT
	default MG_CONN_TIMEOUT

source "Kconfig.zephyr"
