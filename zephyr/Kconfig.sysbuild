# MCUboot's development keys (bootloader/mcuboot/root-*.pem)
# are public, so anyone can sign images a unit built with one accepts. A build
# signed with one fails at configure time unless it says it's for development
# (sysbuild-dev.conf); production sets SB_CONFIG_BOOT_SIGNATURE_KEY_FILE to its
# own private key, kept out of the repository (sysbuild.cmake,
# tools/check_signing_key.py).
config MG_DEV_SIGNING_KEY
	bool "Development build: sign with MCUboot's public development key"
	help
	  Allows SB_CONFIG_BOOT_SIGNATURE_KEY_FILE to be one of MCUboot's public
	  development keys (the default). Units built with it accept any image
	  signed with that key, which anyone can do: for benches and development
	  units only, never for units in users' hands.

# A board with a separate network core names its board (NET_CORE_BOARD, in
# the board's own Kconfig.sysbuild); the Bluetooth controller (Zephyr's
# hci_ipc sample) is then built for it beside the application.
config NET_CORE_BOARD
	string

config NET_CORE_IMAGE_HCI_IPC
	bool "Bluetooth controller image (hci_ipc) on the network core"
	default y
	depends on NET_CORE_BOARD != ""

source "share/sysbuild/Kconfig"
