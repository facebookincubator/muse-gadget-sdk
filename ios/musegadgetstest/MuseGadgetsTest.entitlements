<!--
The app and its broadcast extension (both targets sign with this file) share
their settings and token proof keys in the musegadgets.shared keychain group;
the first group is each one's default, the app's own.
-->
<plist version="1.0">
<dict>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(MG_APP_BUNDLE_ID)</string>
        <string>$(AppIdentifierPrefix)musegadgets.shared</string>
    </array>
</dict>
</plist>
