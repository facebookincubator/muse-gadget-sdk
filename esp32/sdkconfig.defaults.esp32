# Classic ESP32 only: the startup stacks hold the top 128 KB of internal RAM
# until main_task hands them to the heap, so ESP-IDF's own internal DMA
# reserve, taken after that, stays here. CONFIG_HOMEHUB_DMA_RESERVE_KB isn't
# offered on this chip.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
