# Experiment: 128 KiB TCP send buffer and receive window, with window scaling
# (load after sdkconfig.tx-by-ref: lwIP only offers scaling when PSRAM is
# required). Receive mailboxes sized for a full window of MSS segments.
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=2
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=131072
CONFIG_LWIP_TCP_WND_DEFAULT=131072
CONFIG_LWIP_TCP_RECVMBOX_SIZE=128
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=128
