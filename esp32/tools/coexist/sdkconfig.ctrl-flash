# Experiment overlay (load after sdkconfig.nimble-tuned): run the BLE
# controller from flash instead of IRAM (Espressif marks it experimental), with
# flash auto-suspend so erases don't stall the radio. Needs a flash part that
# supports suspend: check before shipping.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
