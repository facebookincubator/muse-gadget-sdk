# Load after sdkconfig.defaults: keep NimBLE up beside Wi-Fi and the Noise
# session, with the basic GATT service. The unauthenticated BLE throughput
# test is only in the bench overlay (sdkconfig.ble-bench).
CONFIG_HOMEHUB_BLE_PERSISTENT=y
# The advertised service takes at most one connection after setup; a second
# keeps BLE usable while some other device holds it (validate_config checks).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
