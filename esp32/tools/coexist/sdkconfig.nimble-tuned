# Experiment overlay (load after sdkconfig.ble-persist): NimBLE sized for a
# gadget that is a GATT server for the phone AND a central that scans for,
# connects to and talks GATT to other devices. All four roles, the GATT
# client and SMP stay on; only what a few links don't need is trimmed.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=16
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
