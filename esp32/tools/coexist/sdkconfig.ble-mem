# Experiment: win back internal RAM with BLE resident (load after
# sdkconfig.ble-persist and sdkconfig.nimble-tuned).
# NimBLE host allocations in PSRAM, controller code in flash.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
# Host/controller buffers sized for a few links instead of the defaults
# (24 ACL, 30+8 events, 24+24 mbufs).
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=6
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
# Wi-Fi RX: fewer always-allocated buffers (the on-demand ones come from
# sdkconfig.defaults.esp32c5 and are in PSRAM). The block-ack window may be
# at most twice the static buffers.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=20
