menu "Muse mirror"

    config MUSE_MIRROR
        bool "Live screen, touch and keys over the console cable"
        depends on MUSE_ENABLED && SPIRAM && !MUSE_UI_FREEINK
        default n
        help
            tools/muse/mirror.py shows the screen and controls the board over
            its existing USB or UART console. Logs share the framed stream.
            The screen copies and message buffer use PSRAM. For development.

    config MUSE_VIRTUAL_DISPLAY_NAME
        string "Virtual display: name"
        depends on MUSE_BOARD_VIRTUAL_DISPLAY
        default "Muse virtual display"
        help
            The viewer draws a known board around the screen when the name
            holds its model, "1.75C" for example.

    config MUSE_VIRTUAL_DISPLAY_WIDTH
        int "Virtual display: width in pixels"
        depends on MUSE_BOARD_VIRTUAL_DISPLAY
        range 64 800
        default 466

    config MUSE_VIRTUAL_DISPLAY_HEIGHT
        int "Virtual display: height in pixels"
        depends on MUSE_BOARD_VIRTUAL_DISPLAY
        range 64 800
        default 466

    config MUSE_VIRTUAL_DISPLAY_ROUND
        bool "Virtual display: round"
        depends on MUSE_BOARD_VIRTUAL_DISPLAY
        default y

    config MUSE_VIRTUAL_DISPLAY_DIAGONAL
        int "Virtual display: diagonal in hundredths of an inch"
        depends on MUSE_BOARD_VIRTUAL_DISPLAY
        range 50 1000
        default 175

endmenu
