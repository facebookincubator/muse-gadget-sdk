    # E-paper boards draw Muse with FreeInk (components/muse/eink/) instead
    # of LVGL: FreeInk drives the panel and its refreshes, and draws the face,
    # Settings and the keyboard. Each one names its FreeInk device profile.
    config MUSE_UI_FREEINK
        bool
        default y if MUSE_BOARD_RETERMINAL_STICKY

    config MUSE_FREEINK_DEVICE
        string
        default "STICKY" if MUSE_BOARD_RETERMINAL_STICKY
        default ""

    config MUSE_STICKY_SD
        bool "Mount the reTerminal Sticky's microSD card at /sdcard"
        depends on MUSE_BOARD_RETERMINAL_STICKY
        default n
        help
            Watches the card-detect pin and mounts an inserted card's FAT
            filesystem at /sdcard (never formatting it), on the panel's SPI
            bus. Nothing in the firmware reads the card yet, so it's off: a
            mount costs a task, time on the bus the e-paper shares, and parsing
            whatever card is inserted. Turn it on for a feature that uses it.

    # The Muse tools' serial port: the console UART behind the board's USB
    # bridge, where the chip's own USB Serial/JTAG isn't wired to a connector
    # (the Watcher's USB-C goes to a CH342) or the chip has none.
    config MUSE_CONSOLE_UART
        bool
        default y if MUSE_BOARD_SENSECAP_WATCHER || MUSE_BOARD_CROWPANEL_ADVANCE_43 || MUSE_BOARD_WAVESHARE_S3_LCD7 || MUSE_BOARD_WAVESHARE_S3_LCD128 || MUSE_BOARD_RETERMINAL_STICKY || MUSE_BOARD_WAVESHARE_P4_LCD35 || !SOC_USB_SERIAL_JTAG_SUPPORTED

    # A board overlay can raise this for a quiet speaker (the CoreS3 sets
    # 100; the BLE gadget profiles 50). Used only until a volume is saved: a
    # stored one always wins.
    config MUSE_DEFAULT_VOLUME
        int "Speaker volume until one is chosen in settings (percent)"
        range 0 100
        default 70

    config MUSE_POWER_TEST
        bool "Isolated board BSP power-characterization firmware"
        # Boards implementing boards/muse_power_test_board.h; extend this list
        # only after the new board's diagnostic hooks and matrix pass tests.
        depends on (MUSE_BOARD_SENSECAP_WATCHER || MUSE_BOARD_WAVESHARE_S3_175C || MUSE_BOARD_WAVESHARE_S3_216 || MUSE_BOARD_AIPI || MUSE_BOARD_RETERMINAL_STICKY || MUSE_BOARD_ESP_MOSAICO) && PM_ENABLE && FREERTOS_USE_TICKLESS_IDLE
        default n
        help
            DIAGNOSTIC ONLY: bypass Home Link and the Muse UI/voice application
            at app_main. USB console arms a timed autonomous or USB-powered BSP-load
            sweep. No credentials, production NVS, BLE provisioning or OTA.
            Results are retained in RAM/RTC for USB readback.
            This characterizes isolated BSP loads, NOT production power.
            Optional camera support is not required and unsupported matrix
            features are explicitly skipped. Never enable in a release profile.

    config MUSE_WATCHER_CAMERA
        bool "SenseCAP Watcher camera capture and live preview"
        depends on MUSE_BOARD_SENSECAP_WATCHER && SPIRAM
        default n
        help
            Enable the camera.capture Home Link command and the wheel
            double-click camera preview. Camera buffers and tasks consume
            memory and preview decoding shares CPU time with voice and Link.
            Leave disabled to build without camera support.

    config MUSE_PHOTO_NOTES
        bool "Photo with voice notes"
        depends on MUSE_WATCHER_CAMERA && MUSE_HATCH
        default y
        help
            Adds "Photo with voice notes" to Settings, off until the person
            turns it on. Then holding the talk button for a voice note also
            takes a photo at the press, shows TAKING A PHOTO, and sends the
            photo after the note's audio, in the same message. Only the
            person's own press takes one this way (not a wake word note), and
            the photo isn't kept once it has gone up. Another camera board
            adds its capture to muse_photo_note.c and to this dependency.

    config MUSE_P4_CSI_CAMERA
        bool "ESP32-P4 MIPI-CSI camera capture"
        depends on MUSE_BOARD_WAVESHARE_P4_LCD35 && SPIRAM
        default n
        help
            Enable the camera.capture Home Link command on an OV5647 module
            on the board's MIPI-CSI connector: esp_video runs the sensor
            through the ISP and the P4's JPEG encoder compresses one frame
            per capture. devices/sdkconfig.muse-waveshare-p4-lcd35-camera
            turns it on with the sensor's settings.

    config MUSE_MOSAICO_CAMERA
        bool "ESP-Mosaico Camera Module capture"
        depends on MUSE_BOARD_ESP_MOSAICO && SPIRAM
        default n
        help
            Enable the camera.capture Home Link command on the Camera Module
            in the board's left expansion slot (an OV3640 or SC101IOT on
            DVP): esp_video runs the sensor, the PPA turns the frame upright
            and the S31's JPEG encoder compresses it. On an SC101IOT the
            module's flash fires when the sensor's auto exposure value is
            high. devices/sdkconfig.muse-esp-mosaico-camera turns it on with
            the sensors' settings.

    config MUSE_CJK_FONT
        bool "Show Chinese, Japanese and Korean in captions"
        depends on MUSE_ENABLED
        default n
        help
            Captions fall back to GNU Unifont's 16x16 bitmaps for CJK
            punctuation, kana, the CJK Unified Ideographs, fullwidth forms,
            Hangul jamo and Hangul syllables that the ASCII caption font
            lacks. Small screens, whose captions are two lines of 8 px
            text, show a reply with CJK in it one 16 px line at a time.
            Takes about 1.2 MB of flash and no RAM. Without it those
            characters show as boxes.

    config MUSE_CJK_FONT_NOTO
        bool "Draw CJK captions with Noto Sans SC instead of Unifont"
        depends on MUSE_CJK_FONT
        default n
        help
            Anti-aliased Noto Sans SC Medium at 16 px in place of Unifont's
            1-bit bitmaps, in the same 16 px cell. Covers the 6763 hanzi of
            GB2312 rather than every CJK Unified Ideograph, and no Hangul:
            rarer characters and Korean show as boxes. Takes about 910 KB of
            flash, against about 1.2 MB.

    config MUSE_LATIN_FONT
        bool "Show Vietnamese and other accented letters in captions"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        default n
        help
            Without it, captions show accented Latin letters as their plain
            ones. With it, a caption with any in it (Latin-1, Latin
            Extended-A, the horned O and U, and Vietnamese's U+1EA0-1EF9)
            shows in GNU Unifont's 8x16 bitmaps, the whole caption in that
            one font. Small screens show such a caption one 16 px line at a
            time. Takes about 10 KB of flash and no RAM.

    config MUSE_EMOJI
        bool "Show emoji in captions"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        default n
        help
            Without it, captions drop emoji. With it, screens whose captions
            use the 16 px caption font (the round and larger ones, such as
            the SenseCAP Watcher) show 190 of the emoji most common in
            replies in colour: Twemoji's, scaled to 16 px, two caption cells
            wide. Others still go, as do skin tones and anything joined to
            an emoji with U+200D. Small screens, whose captions are 8 px
            text, keep dropping them. Takes about 150 KB of flash and 48
            bytes of RAM.

    config MUSE_UI_PANEL_TYPE
        bool "UI type drawn at the panel's size"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        depends on MUSE_BOARD_M5STACK_STOPWATCH || MUSE_BOARD_ESP_MOSAICO || MUSE_BOARD_SENSECAP_WATCHER || MUSE_BOARD_WAVESHARE_C6_18
        default n
        help
            The home, Settings and passcode screens in Montserrat Medium
            subsets made for this board's panel (components/muse/fonts/type),
            instead of LVGL's built-in Montserrat sizes. The board's
            overlay turns it on. Flash: the set takes about 105 KB on the
            Waveshare C6 1.8 (368 px), 107 KB on the SenseCAP Watcher
            (412 px), 120 KB on the StopWatch (466 px) and 134 KB on the
            ESP-Mosaico (480 px). Without it the home's time is LVGL's
            Montserrat 28, or Montserrat 48 where a board's overlay turns
            LV_FONT_MONTSERRAT_48 on (about 94 KB).

    choice MUSE_UI_LANGUAGE
        prompt "Language of the screen's own text"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        default MUSE_UI_LANG_EN
        help
            The state label ("READY") and the captions the firmware shows
            itself ("CAN'T REACH MUSE"). Muse's replies are in whatever
            language you speak to it, and the serial console stays in
            English for the tools that read it. The button menu and the
            pairing card are translated; the touch boards' settings pages
            are in Brazilian Portuguese only.

        config MUSE_UI_LANG_EN
            bool "English"

        config MUSE_UI_LANG_VI
            bool "Vietnamese"
            select MUSE_LATIN_FONT

        config MUSE_UI_LANG_PT_BR
            bool "Brazilian Portuguese"
            select MUSE_LATIN_FONT
            help
                Also translates the touch boards' settings pages and the
                latest-reply page.
    endchoice

    choice MUSE_JC3248W535_MIC
        prompt "JC3248W535: added microphone"
        depends on MUSE_BOARD_GUITION_JC3248W535
        # A configuration from before this choice existed set only the GPIO.
        default MUSE_JC3248W535_MIC_I2S if MUSE_JC3248W535_MIC_GPIO >= 0
        default MUSE_JC3248W535_MIC_NONE
        help
            The board has a speaker amp but no microphone. Pick the one
            you've added; with none, push-to-talk records silence.

        config MUSE_JC3248W535_MIC_NONE
            bool "None"

        config MUSE_JC3248W535_MIC_PDM
            bool "PDM MEMS mic on the 4-pin extension connector"
            help
                A PDM mic such as an MP34DT01 or MP34DT05 module on the 4-pin
                extension connector: CLK to GPIO17, DATA to GPIO18, SEL to
                GND, power to its 3.3 V and GND. The speaker moves to I2S1,
                since only I2S0 converts PDM.

        config MUSE_JC3248W535_MIC_I2S
            bool "I2S MEMS mic on the speaker's clocks"
            help
                An I2S mic such as an INMP441 wired to the speaker's clocks
                (SCK to GPIO42, WS to GPIO2), L/R to GND, power to 3.3 V, and
                its SD line to a free GPIO, set in
                MUSE_JC3248W535_MIC_GPIO.
    endchoice

    config MUSE_JC3248W535_MIC_GPIO
        int "JC3248W535: GPIO for the I2S mic's data (SD) line"
        depends on MUSE_BOARD_GUITION_JC3248W535
        range -1 48
        default -1
        help
            Used only with the I2S mic option; -1 leaves it unconnected.

    config MUSE_STATIC_BUFFERS_IN_PSRAM
        bool "Keep the avatar's and audio's static buffers in PSRAM"
        depends on MUSE_ENABLED && SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
        default n
        help
            Places the zero-initialized statics of the avatar renderer
            (muse_pixel.c: its frame, mask and lookup tables) and the audio
            path (muse_audio.c: the I2S staging and chirp buffers), about
            17 KB, in PSRAM instead of internal RAM (linker.lf). The
            captions' state (muse_subs.c, 4.7 KB) and the musegadgets
            playback and encoder buffers (mg_ble.c, mg_voice.c, about 8 KB)
            go too, on Wi-Fi and BLE-only builds alike. Only the CPU touches them: the avatar is
            scaled into LVGL's draw buffer, and the I2S driver copies to and
            from its own DMA buffers. Turn it on where internal RAM is
            short: the SenseCAP Watcher (it pays for the CPU's light-sleep
            retention memory, which it takes at boot and keeps) and the
            Waveshare S3 1.75C (Wi-Fi and BLE audio together).

    config MUSE_CHARGE_DARK
        bool "Charge dark on a low cell after USB turns the gadget on"
        depends on MUSE_ENABLED
        default y
        help
            Plugging USB into a gadget that is off turns it on (its power
            chip does). On a low cell it then charges dark, with no display
            or radio, and boots by itself once the cell reads the board's
            low-cell level (battery_shutdown_mv, the shutdown voltage)
            plus 300 mV while charging; unplugged first, it powers off
            again. Boards without early_power or battery_shutdown_mv boot
            as before.
            See muse_charge_dark.h.

    config MUSE_CHARGE_DARK_TEST_MV
        int "Bench: charge-dark threshold in mV (0: the board's)"
        depends on MUSE_CHARGE_DARK
        range 0 4400
        default 0
        help
            Bench only: hold dark until the cell reads this instead of the
            board's threshold, so the hold can be tested on a healthy
            cell (4300: a USB power-up stays dark until a key, an unplug or
            the 2 h limit). Never ship it.

    config MUSE_PERF
        bool "Log UI timing on mg.perf (bench)"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        default n
        help
            Frame time (render, panel wait, flush), frames per second,
            touch-to-redraw and talk-button-to-face latency, and each task's
            share of the CPU, logged on mg.perf (and so on the Nordic UART
            mirror). The CPU shares need FREERTOS_USE_TRACE_FACILITY and
            FREERTOS_GENERATE_RUN_TIME_STATS. devices/sdkconfig.muse-bench
            turns all three on.

    config MUSE_PERF_PERIOD_MS
        int "UI timing report period (ms)"
        depends on MUSE_PERF
        range 1000 60000
        default 5000

    config MUSE_BENCH_IMAGE
        bool "A bench/debug image (on-screen diagnostics)"
        depends on MUSE_ENABLED
        default n
        help
            Bench and debug images only (devices/sdkconfig.muse-bench,
            MUSE_BENCH=1): on-screen diagnostics a shipping image keeps off,
            such as the calling screen's step line (what the call start
            is doing and the seconds since the tap). A shipping image shows
            that line only while the console word call.steps=1 is set (RAM
            only, off at every boot).

    config MUSE_PAIR_CONFIRM_CONSOLE
        bool "Test rigs: confirm Muse app setup from the serial console (bench)"
        depends on MUSE_ENABLED
        default n
        help
            The console line >pair.confirm presses the talk button for a Muse
            app setup waiting for it, so a rig runs setup with nobody at the
            bench (tools/mg_confirm.py, tools/mg_ble_client.py setup
            --confirm-serial). It goes through the button's own confirm path,
            never push-to-talk. Test and bench builds only: the Muse Gadget
            setup contract lets a gadget simulate the press only there, and a
            shipping build never confirms without the button.
            devices/sdkconfig.muse-bench (MUSE_BENCH=1) turns it on. Off, the
            line answers "@pair.confirm disabled".

    config MUSE_SMALL_FULL_REPLY
        bool "Full-screen replies on small screens"
        depends on MUSE_ENABLED
        default n
        help
            On screens with the compact layout (under 200 px or so), Muse
            normally keeps the avatar and pages replies two lines at a time
            in a band along the bottom. With this on, the avatar steps aside
            while Muse thinks or answers, and the reply fills the screen
            below the status line. Muse comes back when the reply ends.
            The reply's font follows the Text size setting (Extra small to
            Extra large, kept across restarts): in the menu on boards with
            the two-button menu, under Brightness in Settings on touch
            boards. Until it's set, replies are Small (Montserrat 14).
            Lines wrap to the screen's width in pixels, so every page fits
            at any size. A page with Chinese, Japanese or Korean in it
            (MUSE_CJK_FONT) or accented letters (MUSE_LATIN_FONT) shows in
            that font, as on the band, whatever the Text size.

    config MUSE_HATCH
        bool "Muse's own voice session"
        depends on MUSE_ENABLED
        default y if SPIRAM
        default n
        help
            Push-to-talk turns go over a voice session of Muse's own, to the
            VM Home Link is paired with or one set up on the device with a
            device token. Replies are text, shown as captions; start_tts in
            muse_chat_session.cpp is where a TTS API of your own can speak
            them. Needs PSRAM. Without it, voice notes go over Home Link's own
            session to its paired VM and replies are shown as text.

    config MUSE_REPLY_NOTIFY
        bool "Flash the screen and ping when a reply arrives"
        depends on MUSE_HATCH && !MUSE_UI_FREEINK
        default n
        help
            When Muse's reply to a voice note arrives, the screen wakes and
            flashes twice, and with the speaker on and the volume above zero
            a short two-note ping plays first. For boards without a vibration
            motor (the SenseCAP Watcher), so a reply is noticed with the
            device out of hand.

    config MUSE_RESEND_NOTES
        bool "Keep sending a voice note until Muse has it"
        depends on MUSE_HATCH
        default n
        help
            Changes how voice notes that didn't reach Muse are kept in PSRAM
            and sent again. Without it, up to 4 wait, each is tried up to 8
            times with the wait doubling from 15 s to 2 minutes, and a press
            is refused while 4 wait. With it, up to MUSE_RESEND_NOTES_MAX
            notes in MUSE_RESEND_NOTES_KB of PSRAM wait, and a new one
            drops the oldest to make room. Each is tried again after 5, 15
            and 30 s, then every 60 s, oldest first, until Muse has it. The
            screen says SAVED, WILL TRY AGAIN once; later tries show
            nothing until the note lands, and then its reply plays (asleep,
            the reply waits in the Muse app, as before).

            A note Muse refused (an HTTP 4xx other than 408 or 429) isn't
            sent again. Neither is one that went up whole without Muse
            acknowledging it: the chat has no way to tell a repeat, and
            Muse may have it already, so the screen says to check the Muse
            app. Kept notes are in RAM only, and a restart loses them.

    config MUSE_RESEND_NOTES_MAX
        int "Voice notes kept to send again"
        depends on MUSE_RESEND_NOTES
        range 1 8
        default 6

    config MUSE_RESEND_NOTES_KB
        int "PSRAM for voice notes kept to send again (KB)"
        depends on MUSE_RESEND_NOTES
        range 512 4096
        default 1536
        help
            A second of a note takes about 31 KB, so the longest, 15
            seconds, takes 469 KB.

    config MUSE_REALTIME_VOICE
        bool "Live voice calls with Muse (experimental)"
        depends on (MUSE_HATCH || HOMEHUB_VOICE) && SPIRAM
        select MUSE_STATIC_BUFFERS_IN_PSRAM if MUSE_ENABLED && SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
        default n
        help
            A tap on the talk button starts a live voice call with Muse over
            the voice session; the next press hangs up. Holding the button
            still sends a voice note. On the StopWatch, holding yellow talks
            in a call instead, blue hangs up, and voice notes are a Sound
            setting. The mic is shut while Muse is talking
            unless the board's audio chip confirms echo cancellation (the
            Home Assistant Voice PE's XMOS), so you take turns. The call
            also ends when Muse ends it, when nothing has been said or
            played for the idle limit, or at the length limit. Muse's VM
            has to accept voice calls from this gadget's credentials.
            On Muse UI boards, static avatar and audio buffers move to PSRAM
            to leave internal DMA memory for the live audio path.

    config MUSE_VOICE_NOTE_TOGGLE
        bool "Press once to record a voice note, press again to send"
        depends on MUSE_ENABLED && !MUSE_REALTIME_VOICE
        depends on !MUSE_BOARD_SENSECAP_WATCHER && !MUSE_UI_FREEINK
        default n
        help
            A talk-button press starts recording and the next press sends
            the note. Releasing the button does not stop recording. A press
            that wakes the display only wakes it. A note needs at least
            500 ms of audio before the press that sends it, and recording
            still ends at the normal 15-second limit. While a note records,
            the other buttons don't open the menu or sleep the screen.
            Replies remain text unless a separate TTS integration is
            provided. Not available on the SenseCAP Watcher, whose wheel
            click sleeps, or on e-paper (FreeInk) boards.

if MUSE_REALTIME_VOICE

    config MUSE_REALTIME_VOICE_APP_ID
        string "App ID the voice session connects as"
        default "hatch-web"
        help
            Sent as app_id when the voice session connects, which is where
            Muse's VM takes the app identity for every request on that
            connection: calls, and voice notes and typed messages too (it
            drops a per-request x-app-id). A call is refused without one. A
            positive 64-bit app ID, or "hatch-web", the web app's. Empty
            sends none. Builds without calls send none either.

    config MUSE_REALTIME_VOICE_IDLE_S
        int "Hang up after this many quiet seconds"
        range 15 1800
        default 45
        help
            Nothing said and nothing audible from Muse for this long ends
            the call. The server may enforce a shorter idle limit.

    config MUSE_REALTIME_VOICE_MAX_S
        int "Longest call, in seconds"
        range 60 7200
        default 900

    config MUSE_REALTIME_VOICE_GREETING
        bool "Muse says hello when a call starts"
        default n

    config MUSE_REALTIME_VOICE_AEC_DUPLEX
        bool "Keep the mic open while Muse talks if echo is cancelled"
        depends on HOMEHUB_VOICE
        default y
        help
            On the Voice PE, when the XMOS reports at start-up that its
            output is echo-cancelled, the call is full duplex and you can
            talk over Muse. Otherwise, and on other boards, the mic is shut
            while Muse is audibly talking and for a moment after.

    config MUSE_VOICE_SOFTWARE_AEC
        bool "Software echo cancellation for hands-free voice interruption"
        depends on IDF_TARGET_ESP32S3 && MUSE_ENABLED && SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY
        select MUSE_STATIC_BUFFERS_IN_PSRAM
        default n
        help
            Use Espressif's full-duplex echo canceller to keep the mic
            available while Muse speaks. Requires a board with enough
            internal RAM and PSRAM, plus a calibrated speaker reference
            delay. If initialization fails, calls remain half-duplex.

    config MUSE_VOICE_AEC_REF_DELAY_CHUNKS
        int "Speaker-to-mic reference delay in 20 ms chunks"
        depends on MUSE_VOICE_SOFTWARE_AEC
        range 1 10
        default 2
        help
            Set per board after measuring the delay between a speaker write
            and its echo in the microphone. The Waveshare 2.06 watch measured
            about 50 ms, so two chunks place the reference within the AEC
            filter's remaining adjustment range. Other boards need a bench
            measurement before enabling this feature.

endif

    # Always defined, so idf_component.yml can key esp-sr on it in every build
    # (a bool whose dependencies are unmet isn't written to sdkconfig).
    config MUSE_VOICE_AEC_SR
        string
        default "y" if MUSE_VOICE_SOFTWARE_AEC
        default "n"

    config MUSE_HATCH_COMPACT_BUFFERS
        bool "Smaller voice session buffers, for 2 MB of PSRAM"
        depends on MUSE_HATCH
        default n
        help
            The voice session keeps about 830 KB of audio buffers in PSRAM:
            512 KB of reply speech, 8 s of mic backlog and 2 s of decoded
            audio. With 2 MB of PSRAM that leaves too little once Home Link
            is connected, and a chat turn runs out of memory. This keeps
            128 KB of speech, 2 s of mic backlog and 1 s of decoded audio
            (about 220 KB), which still covers a push-to-talk turn. Board
            overlays with 2 MB of PSRAM turn it on.

    config CAPABILITIES_REGISTRY
        bool
        help
            The device registry (components/capabilities_registry) and the drivers that
            describe the gadget's sensors and outputs to it: the battery, and
            whatever the board file registers (motors, IMUs). Only WebAssembly
            apps read it so far, and they select it; without it none of this
            is built.

    config MUSE_APP_VIEW
        bool
        help
            The screen an app runs on (muse_app_view.c): a full-screen LVGL
            root over the face that the app's objects go under, with touch,
            gestures and the buttons by role. The power key, a voice call or
            the video view closes it. WebAssembly apps select it
            (components/muse_apps).

    config MUSE_VIDEO
        bool "Video streaming from a phone to the display"
        depends on MUSE_ENABLED && SPIRAM && (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S31) && !MUSE_UI_FREEINK
        default n
        help
            A phone (Muse Gadgets Test, android/musegadgetstest) streams its camera, or
            a clip, as H.264 constrained baseline (or VP8, MUSE_VIDEO_VP8);
            the board decodes it (components/tinyh264) and shows it full
            screen, scaled to fit.
            The menu gets a Phone camera item that asks the phone for a
            stream. Needs a board whose panel driver has draw_frame (the
            Waveshare S3 1.75 and 1.75C, the StopWatch, the ESP-Mosaico),
            PSRAM for the receive ring and the decoder's pictures, and the
            S3's SIMD or the S31's speed for the colour conversion. About
            100 KB of flash; the decoder's hot code can go in IRAM
            (MUSE_VIDEO_DECODER_IRAM).
            protocols/VIDEO.md has the design.

    config MUSE_VIDEO_WIFI
        bool "Take streams over Wi-Fi"
        depends on MUSE_VIDEO
        default y
        help
            The stream over TCP on the local network: the board listens on
            MUSE_VIDEO_WIFI_PORT and announces itself over mDNS as
            _musevideo._tcp, so the phone finds it on the same network.
            protocols/VIDEO.md has the wire format.

    # Always defined for component-manager rules, even when the registry bool
    # is omitted from sdkconfig. Only the StopWatch family (the StopWatch and
    # the TriviaPOD, one board file) uses this driver.
    config MUSE_BMI270_DRIVER
        string
        default "y" if MUSE_BOARD_M5STACK_STOPWATCH_FAMILY && CAPABILITIES_REGISTRY
        default "n"

    # Always defined, so idf_component.yml can key mDNS on it in every build
    # (a bool whose dependencies are unmet isn't written to sdkconfig).
    config MUSE_VIDEO_MDNS
        string
        default "y" if MUSE_VIDEO_WIFI
        default "n"

    config MUSE_VIDEO_WIFI_PORT
        int "TCP port for video over Wi-Fi"
        depends on MUSE_VIDEO_WIFI
        range 1024 65535
        default 7766

    config MUSE_VIDEO_WIFI_START_ANYTIME
        bool "Accept a Wi-Fi stream with the Phone camera view closed (bench builds only)"
        depends on MUSE_VIDEO_WIFI
        default n
        help
            The Wi-Fi port is unauthenticated: anyone on the network can
            connect. By default the board takes a stream only while someone
            has opened Phone camera on it (a client hears "closed" otherwise
            and waits for "want"), so a stranger can't wake the screen, draw on
            it or keep the radio busy. Turn this on only for automated
            benches that start streams without touching the board.

    config MUSE_VIDEO_VP8
        bool "VP8 as well as H.264"
        depends on MUSE_VIDEO
        default y
        help
            Decode VP8 streams too (components/libvpx_vp8, libvpx's decoder:
            BSD-3-Clause with the WebM project's patent grant, no
            royalty-charging patent pool). The board lists it in hello's
            codecs and the client picks. About 45 KB of flash; on the S3 it
            decodes a 232 px stream at 1000 kb/s in 24 ms a frame against
            tinyh264's 33, for the same picture. protocols/VIDEO.md has the
            numbers.

    config MUSE_VIDEO_VP8_PROF
        bool "Log VP8 decode time per stage (bench)"
        depends on MUSE_VIDEO_VP8
        default n
        help
            Times the VP8 decoder's stages with the CPU cycle counter and logs
            them with the video stats. Costs a little decode time.

    config MUSE_VIDEO_DECODER_IRAM
        bool "Decoder's hot code in IRAM"
        depends on MUSE_VIDEO
        default n
        help
            tinyh264's per-macroblock code and tables in IRAM (about 44 KB;
            with MUSE_VIDEO_VP8, libvpx_vp8's too, by default its compact
            set, about 33 KB more: MUSE_VP8_IRAM),
            so the decoder never waits on the instruction cache. On the S3
            that comes out of the heap; a board running Wi-Fi, BLE and the
            UI can't spare it. Measured on the Waveshare S3 1.75C: see
            protocols/VIDEO.md. (The colour conversion, 4 KB, is always in
            IRAM: from the cache it slows both it and the decoder by a
            quarter.)

    config MUSE_VIDEO_SIMD_MC
        bool "Motion compensation on the S31's SIMD"
        depends on MUSE_VIDEO && IDF_TARGET_ESP32S31
        default n
        help
            tinyh264's luma 6-tap filters and chroma on the ESP32-S31's SIMD.
            Checked against the C on first use (the C stays if they differ,
            logged on tinyh264). Off by default: correct, but slower on the
            board than the C (480 px in two bands: 40 ms a frame against
            28), so experimental.

    config MUSE_VIDEO_BUFFER
        int "Video receive buffer (bytes, a power of two)"
        depends on MUSE_VIDEO
        range 16384 262144
        default 131072
        help
            The client may have this much in flight; in PSRAM. 128 KB holds
            about half a second at 2 Mb/s, enough for a keyframe and the
            frames behind it.

endmenu
