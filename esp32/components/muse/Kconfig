    config MUSE_MOTION_GESTURES
        bool "Lift to wake and face-down quiet (1.75C)"
        depends on MUSE_BOARD_WAVESHARE_S3_175C
        default n
        help
            Adds opt-in motion controls to Settings > Auto-sleep. Both start
            off. Uses the QMI8658 accelerometer at low-power 21 Hz with the
            gyroscope disabled. Lift wake polls at 20 Hz; quiet-only uses
            10 Hz awake and 4 Hz asleep. Battery use increases. Does not
            wake from a full power-off.

    config MUSE_C6_DRAW_BUF_LINES
        int "C6 display buffer height (lines)"
        depends on MUSE_BOARD_WAVESHARE_C6_18
        range 4 64
        default 48 if MUSE_GADGET_BLE_STANDALONE && MUSE_PERF
        default 16
        help
            Height of each of the two internal-RAM DMA buffers. More lines
            reduce LVGL strip/walk overhead but take RAM from audio and offline
            clips: every extra line costs 1472 bytes across the two buffers.
            Keep the normal build at 16 until heap and gesture measurements
            justify a larger value. BLE performance builds default to 48.
            Set this in a per-build sdkconfig and rebuild to compare heights;
            the live console cannot safely replace adapter-owned buffers.

    config MUSE_ENABLED
        bool
        default y if !MUSE_BOARD_NONE
        select HOMEHUB_DAEMON_REQUESTS   # voice notes and chat over Link's session

