menu "Muse"

    config MUSE_UI_THEME
        bool "Light and dark appearance"
        depends on MUSE_ENABLED && !MUSE_UI_FREEINK
        default n
        help
            Adds Automatic, Dark and Light appearance choices to Settings.
            Automatic uses an optional content-background hint and otherwise
            keeps the existing dark appearance. No avatar feature is needed.

    config MUSE_AVATAR_SYNC
        bool "Sync the paired Muse avatar (experimental)"
        depends on MUSE_ENABLED && SPIRAM && !MUSE_UI_FREEINK
        depends on HOMEHUB_DAEMON_REQUESTS
        default n
        help
            Adds an optional My Muse avatar source. Built-in remains the
            default and can be selected without restarting. Requires PSRAM
            for bounded image decoding. Initially validated on the 1.75C.

    config MUSE_AVATAR_ANIMATIONS
        bool "Experimental phone-avatar clip playback"
        depends on MUSE_AVATAR_SYNC && (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4)
        default n
        help
            Adds bounded local H.264 clip packs to My Muse, rendered in the
            existing home canvas. Uses the same TinyH264 software decoder and
            scalar RGB565 conversion on the ESP32-S3 and ESP32-P4; the P4's
            hardware H.264 encoder is not used. Requires conversion of phone
            MP4 assets. Missing interactive clips keep the personal image with
            local feedback. This does not provide a personal face or mouth rig.
            No camera view, Wi-Fi listener, or video transport is enabled.

    # Always present in sdkconfig.json, including when the bool is disabled.
    # The component manager resolves manifests before all managed Kconfigs.
    config MUSE_AVATAR_DEPS
        string
        default "y" if MUSE_AVATAR_SYNC
        default "n"

    config MUSE_LATEST_REPLY
        bool "Latest reply screen"
        depends on MUSE_BOARD_WAVESHARE_S3_175C && SPIRAM && MUSE_HATCH
        default y
        help
            Swipe right from Main to reread the latest received answer.
            Keeps up to 32 KiB in PSRAM until reboot; receiver message slots
            use 256 KiB. No conversation text is written to flash.

    choice MUSE_BOARD
        prompt "Board with the full UI"
        default MUSE_BOARD_NONE
        help
            The UI is the voice companion on boards with a screen: an
            animated avatar, push-to-talk chat, settings, and battery
            handling. It runs beside Home Link, which owns Wi-Fi, BLE
            pairing, credentials and OTA. Pick the board it runs on, or none
            for a Link without a display.

