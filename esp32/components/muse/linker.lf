# CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM: the avatar's and audio's
# zero-initialized statics go to PSRAM (.ext_ram.bss, cleared at startup).
# Their initialized data stays internal. A custom avatar keeps the object
# name muse_pixel, so it follows.
[scheme:muse_extram_bss]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:muse]
archive: libmuse.a
entries:
    if MUSE_STATIC_BUFFERS_IN_PSRAM = y:
        muse_pixel (muse_extram_bss)
        muse_audio (muse_extram_bss)
    else:
        * (default)
