# CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM: the avatar's and audio's
# zero-initialized statics go to PSRAM (.ext_ram.bss,
# cleared at startup), on Wi-Fi and BLE-only builds alike (the
# Watcher's BLE-only build idles at 12 KB internal with the captions kept in).
# Their initialized data stays internal. A custom avatar keeps the object
# name muse_pixel, so it follows.
[scheme:muse_extram_bss]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:muse]
archive: libmuse.a
entries:
    if MUSE_STATIC_BUFFERS_IN_PSRAM = y:
        muse_pixel (muse_extram_bss)
        muse_audio (muse_extram_bss)
        # The UI's own state: LVGL objects and layout, touched only from tasks (no ISR, no
        # flash-write path), so PSRAM serves it. The passcode's record and typed digits
        # (muse_passcode, muse_passcode_ui) stay in internal RAM, as does muse_f2's NVS diagnostic.
        muse_home (muse_extram_bss)
        muse_settings_ui (muse_extram_bss)
        muse_ui (muse_extram_bss)
        muse_touch (muse_extram_bss)
        muse_turn_dot (muse_extram_bss)
        muse_mic_ring (muse_extram_bss)
        muse_lvgl_hold (muse_extram_bss)
    else:
        * (default)
