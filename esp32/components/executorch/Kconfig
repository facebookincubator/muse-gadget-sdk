# GENERATED by examples/espressif/build_idf_component.sh -- do not edit.
menu "ExecuTorch"

    config ET_ENABLE
        bool "Build the ExecuTorch runtime into the firmware"
        default n
        help
            ESP-IDF links every component under components/ into the
            image, and this component's kernel registration is
            deliberately GC-proof (whole-archive), so it is off by
            default: while disabled it registers empty and firmware is
            unchanged. Set it, or "select ET_ENABLE" from a consumer's
            Kconfig.

    if ET_ENABLE

    choice ET_OP_PROFILE
        prompt "Op profile"
        help
            Which operator set (kernel registration) to compile in.
            Baked in at component generation time; see VERSION for the
            exact ops and op-set hash of each profile. A .pte only
            runs on a profile whose op set covers it.
        default ET_OP_PROFILE_WAKEWORD_INT8
        config ET_OP_PROFILE_WAKEWORD_INT8
            bool "wakeword_int8"
    endchoice

    config ET_ENABLE_LOGGING
        bool "Enable ExecuTorch runtime logging"
        default y
        help
            When disabled, ET_LOG is compiled out entirely
            (ET_LOG_ENABLED=0). When enabled, messages go through
            ESP_LOG under the "executorch" tag.

    choice ET_LOG_LEVEL
        prompt "ExecuTorch log level floor"
        default ET_LOG_LEVEL_INFO
        depends on ET_ENABLE_LOGGING
        help
            Compile-time floor (ET_MIN_LOG_LEVEL), also applied in
            the PAL, on top of the usual IDF runtime log levels.

        config ET_LOG_LEVEL_ERROR
            bool "Error"
        config ET_LOG_LEVEL_WARN
            bool "Warning"
        config ET_LOG_LEVEL_INFO
            bool "Info"
        config ET_LOG_LEVEL_DEBUG
            bool "Debug"
    endchoice

    config ET_OPTIMIZE_SIZE
        bool "Build the runtime with -Os"
        default n
        help
            Optimize the ExecuTorch runtime for size regardless of the
            project's compiler optimization level.

    config ET_PROGRAM_VERIFICATION
        bool "Compile in full .pte verification"
        default n
        help
            Required for et_model_config_t.verify; without it
            et_model_create rejects verify requests.

    config ET_DEBUG_ASSERTS
        bool "Keep ExecuTorch debug assertions"
        default n
        help
            When disabled, the runtime builds with NDEBUG.

    config ET_MAX_KERNEL_NUM
        int "Kernel registry size (0 = selected profile's op count)"
        default 0
        help
            Raise this when the application registers its own kernels.
            Must not be below the selected profile's kernel count.

    endif # ET_ENABLE

endmenu
