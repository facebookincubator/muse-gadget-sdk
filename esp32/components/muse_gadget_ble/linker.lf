# CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM: the zero-initialized
# statics of mg_ble.c (the player's FIFO and frames, the playback write
# buffer, the offline queue's state) and mg_voice.c (the encoder's output),
# about 8 KB, go to PSRAM (.ext_ram.bss, cleared at startup). Only tasks touch
# them (the NimBLE host, the worker, the player, the voice loop), never DMA.
# BLE-only builds too (the Watcher's watcher-video idles at 12 KB
# internal with them in).
[scheme:mg_extram_bss]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:muse_gadget_ble]
archive: libmuse_gadget_ble.a
entries:
    if MUSE_STATIC_BUFFERS_IN_PSRAM = y:
        mg_ble (mg_extram_bss)
        mg_voice (mg_extram_bss)
    else:
        * (default)
