# Always defined, unlike MUSE_WAKEWORD_ENABLE (a bool whose dependencies are
# unmet isn't written to sdkconfig), so this component's idf_component.yml can
# pull the ExecuTorch registry component only into builds with the feature.
config MUSE_WAKEWORD_EXECUTORCH
    string
    default "y" if MUSE_WAKEWORD_ENABLE
    default "n"

menu "Muse wake word"
    depends on MUSE_ENABLED

    config MUSE_WAKEWORD_ENABLE
        bool "Compile in hands-free wake word support"
        depends on SPIRAM
        default n
        help
            Saying "Hey Muse" (or "Ok Muse") starts the same voice note
            as holding the talk button. This only compiles the feature
            in: listening also needs a runtime opt-in, so flashing this
            firmware never starts listening on its own.

            The session core, audio rings, energy endpointing, LFBE
            frontend, detector, and ExecuTorch runner are built here;
            the runtime comes from the ExecuTorch registry component.
            No board overlay enables this yet; enablement
            is per-board and opt-in. The current model is a
            synthetic-data research checkpoint, not a
            production-tuned detector. Needs PSRAM: the audio
            buffers take about 115 KB, and the ExecuTorch runner
            about 215 KB more (model arenas and the frontend).

    choice MUSE_WAKEWORD_SENSITIVITY
        prompt "Wake word sensitivity"
        default MUSE_WAKEWORD_SENSITIVITY_DEFAULT
        depends on MUSE_WAKEWORD_ENABLE
        help
            Passed to the runner as a preset. Raw detection thresholds are
            the runner's, never Kconfig values.

        config MUSE_WAKEWORD_SENSITIVITY_LOW
            bool "Low (fewest false triggers)"

        config MUSE_WAKEWORD_SENSITIVITY_DEFAULT
            bool "Default"

        config MUSE_WAKEWORD_SENSITIVITY_HIGH
            bool "High (easiest to trigger)"
    endchoice

    choice MUSE_WAKEWORD_VAD
        prompt "Speech endpointing after a wake"
        default MUSE_WAKEWORD_VAD_ENERGY
        depends on MUSE_WAKEWORD_ENABLE
        help
            How the end of a hands-free turn is judged. Higher tiers are
            only offered when their model is integrated and the board's
            budgets allow them.

        config MUSE_WAKEWORD_VAD_ENERGY
            bool "Energy (audio level, no model)"
    endchoice

    config MUSE_WAKEWORD_START_TIMEOUT_MS
        int "No speech after a wake cancels the turn (ms)"
        default 2500
        range 100 10000
        depends on MUSE_WAKEWORD_ENABLE
        help
            The main false-trigger defence: if no speech follows the wake
            word within this time, the attempt is dropped and no audio
            leaves the device.

    config MUSE_WAKEWORD_END_SILENCE_MS
        int "Trailing silence that ends a hands-free turn (ms)"
        default 700
        range 100 5000
        depends on MUSE_WAKEWORD_ENABLE

    config MUSE_WAKEWORD_MAX_CAPTURE_MS
        int "Longest hands-free turn (ms)"
        default 15000
        range 1000 15000
        depends on MUSE_WAKEWORD_ENABLE
        help
            Hard cap even if endpointing never fires. The top of the range
            is the push-to-talk cap in muse_voice.c; a longer hands-free
            turn than a held button could record makes no sense.

endmenu
