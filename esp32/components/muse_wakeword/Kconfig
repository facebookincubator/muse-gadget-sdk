# Always defined, unlike MUSE_WAKEWORD_ENABLE (a bool whose dependencies are
# unmet isn't written to sdkconfig), so this component's idf_component.yml can
# pull the ExecuTorch registry component only into builds with the feature.
config MUSE_WAKEWORD_EXECUTORCH
    string
    default "y" if MUSE_WAKEWORD_ENABLE
    default "n"

menu "Muse wake word"
    depends on MUSE_ENABLED

    config MUSE_WAKEWORD_ENABLE
        bool "Compile in hands-free wake word support"
        depends on SPIRAM && !MUSE_UI_FREEINK
        default n
        help
            Saying "Hey Muse" (or "Ok Muse") starts the same voice note
            as holding the talk button. This only compiles the feature
            in: listening also needs the opt-in on the device itself
            (Settings > Sound, the quick menu, or "wake.on" over
            serial), so flashing this firmware never starts listening
            on its own. No board overlay enables it.

            While listening is on, the microphone and codecs stay
            powered, so a battery board doesn't rest them when its
            screen sleeps: expect much shorter battery life with the
            wake word on.

            Detection runs on the device: the ExecuTorch model in
            models/hey_muse.pte, an int8 export of a streaming
            keyword-spotting network trained on synthetic speech from
            eight Piper voices (see models/README.md). Audio leaves the
            device only after a detection, as a voice note that starts
            at most 1 s before the speech following it (so it includes
            the wake word) and ends with that speech, the talk button,
            or 15 s. A detection with no speech after it sends nothing;
            one followed by speech sends a voice note, so a false
            trigger near conversation uploads one. This checkpoint's own
            streaming test (fp32, on its training bundle's test set)
            reports about 34 false wakes an hour at Default sensitivity
            (78.7% of wake words caught) and about 4 an hour at Low
            (51.3%); High wasn't measured. The int8 model on the device
            has not been measured on a device yet.

            Needs PSRAM: the audio buffers take about 133 KB and the
            ExecuTorch runner about 213 KB more (a 64 KB method arena,
            a 64 KB scratch arena, the model's 29.5 KB planned buffer
            and the 52 KB frontend), far beyond the internal RAM left
            with Wi-Fi up. Not available with the e-paper (FreeInk) UI,
            which has no wake word controls.

    choice MUSE_WAKEWORD_SENSITIVITY
        prompt "Wake word sensitivity"
        default MUSE_WAKEWORD_SENSITIVITY_DEFAULT
        depends on MUSE_WAKEWORD_ENABLE
        help
            The detector's threshold on the smoothed wake posterior
            (ww_detector.c): Low 0.99, Default 0.95, High 0.90. False wakes
            per hour on the checkpoint's own fp32 streaming test: about 4
            at Low and 34 at Default; High wasn't measured.

        config MUSE_WAKEWORD_SENSITIVITY_LOW
            bool "Low (about 4 false wakes an hour)"

        config MUSE_WAKEWORD_SENSITIVITY_DEFAULT
            bool "Default (about 34 false wakes an hour)"

        config MUSE_WAKEWORD_SENSITIVITY_HIGH
            bool "High (easiest to trigger; not measured)"
    endchoice

    choice MUSE_WAKEWORD_VAD
        prompt "Speech endpointing after a wake"
        default MUSE_WAKEWORD_VAD_ENERGY
        depends on MUSE_WAKEWORD_ENABLE
        help
            How the end of a hands-free turn is judged. Higher tiers are
            only offered when their model is integrated and the board's
            budgets allow them.

        config MUSE_WAKEWORD_VAD_ENERGY
            bool "Energy (audio level, no model)"
    endchoice

    config MUSE_WAKEWORD_START_TIMEOUT_MS
        int "No speech after a wake cancels the turn (ms)"
        default 2500
        range 100 10000
        depends on MUSE_WAKEWORD_ENABLE
        help
            The main false-trigger defence: if no speech follows the wake
            word within this time, the attempt is dropped and no audio
            leaves the device.

    config MUSE_WAKEWORD_END_SILENCE_MS
        int "Trailing silence that ends a hands-free turn (ms)"
        default 700
        range 100 5000
        depends on MUSE_WAKEWORD_ENABLE

    config MUSE_WAKEWORD_MAX_CAPTURE_MS
        int "Longest hands-free turn (ms)"
        default 15000
        range 1000 15000
        depends on MUSE_WAKEWORD_ENABLE
        help
            Hard cap even if endpointing never fires. The top of the range
            is the push-to-talk cap in muse_voice.c; a longer hands-free
            turn than a held button could record makes no sense.

endmenu
