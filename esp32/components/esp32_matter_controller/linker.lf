# Matter's static data in PSRAM, on boards that allow it
# (SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY,
# devices/sdkconfig.matter-controller-psram). CHIP is built inside esp-matter's
# library, and esp-matter's singletons (the controller and its
# DeviceCommissioner, the pairing command) are statics in inline functions, so
# they land in the first library that uses them: this one.
[mapping:esp32_matter_controller]
archive: libesp32_matter_controller.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (extram_bss)

[mapping:esp32_matter_controller_esp_matter]
archive: libespressif__esp_matter.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (extram_bss)
