# With CONFIG_MUSE_VIDEO_DECODER_IRAM the decoder's per-macroblock code runs
# from IRAM (about 44 KB at -O2, its tables included): from PSRAM or flash it
# shares the 32 KB instruction cache with the radio and the panel, and misses
# on every macroblock. On the S3 IRAM and DRAM are the same SRAM, so that is
# 44 KB less heap: a board running Wi-Fi, BLE and the UI beside it can't
# spare it (LVGL's task no longer starts), and runs the decoder from cache.
[mapping:tinyh264]
archive: libtinyh264.a
entries:
    if MUSE_VIDEO_DECODER_IRAM = y:
        h264bsd_byte_stream (noflash)
        h264bsd_cavlc (noflash)
        h264bsd_deblocking (noflash)
        h264bsd_image (noflash)
        h264bsd_inter_prediction (noflash)
        h264bsd_intra_prediction (noflash)
        h264bsd_macroblock_layer (noflash)
        h264bsd_neighbour (noflash)
        h264bsd_reconstruct (noflash)
        h264bsd_slice_data (noflash)
        h264bsd_stream (noflash)
        h264bsd_transform (noflash)
        h264bsd_util (noflash)
        h264bsd_vlc (noflash)
    else:
        * (default)
