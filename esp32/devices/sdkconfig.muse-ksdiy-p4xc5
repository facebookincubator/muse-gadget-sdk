# KSDIY P4XC5 4.3 inch: ESP32-P4 v3.x, 16MB flash, onboard PSRAM.
# Source: ESP32P4_KSDIY/P4_C5_4.3_Firmware/50.application.music_performer
# sdkconfig + vendor BSP. P4 native USB Serial/JTAG; C5 is an SDIO coprocessor.
# Load after sdkconfig.defaults and devices/sdkconfig.muse.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_MUSE_BOARD_KSDIY_P4XC5=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_HOMEHUB_BUTTON_GPIO=35
CONFIG_KSDIY_P4C5_LCD_RGB565=y
CONFIG_LV_COLOR_DEPTH=16
# P4 has no local radio. Both Wi-Fi and BLE run on the onboard C5 (ESP-Hosted 2.12.x).
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# Match 04.advanced.p4c5_board_test/sdkconfig.defaults (Hosted RPC stability on P4+C5).
CONFIG_WIFI_RMT_IRAM_OPT=n
CONFIG_WIFI_RMT_EXTRA_IRAM_OPT=n
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_HOST_CP_RESET_STRATEGY_ALWAYS=y
CONFIG_ESP_HOSTED_HOST_CP_RESET_SETTLE_MS=1500
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
# ESP32-P4 ROM has no tjpgd; display.draw_url JPEG decode needs rom/tjpgd.h.
# CONFIG_HOMEHUB_DISPLAY_COMMANDS is not set
