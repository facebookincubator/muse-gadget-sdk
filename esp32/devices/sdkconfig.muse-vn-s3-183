# VN ESP32-S3 1.83-inch NV3023: ESP32-S3R8 (16 MB flash, 8 MB octal PSRAM),
# 1.83" 284x240 NV3023 LCD, ES8311 speaker, ES7210 mics, BOOT/Vol+/Vol-,
# battery. Native USB Serial/JTAG (303a:1001), BOOT on GPIO0.
# Source: its xiaozhi port, https://github.com/TienHuyIoT/xiaozhi-esp32_vietnam,
# main/boards/xiaozhi-ai-iot-vietnam-1st/
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_VN_S3_183=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM is required for the UI, images, voice session and tunnel.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). Without it free
# internal RAM falls to 6 KB pieces and BLE setup can't start its 8 KB task.
# The chip always has PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
