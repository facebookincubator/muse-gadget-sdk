# The "Hey Muse" wake word with the ExecuTorch runner, for a board with the
# full UI and PSRAM, loaded after its own overlay:
#   MUSE_WAKEWORD=1 tools/muse/board.sh build|flash <board>
# The build needs a Python with executorch (EXECUTORCH_PYTHON; see
# docs/executorch.md). Listening still needs the runtime opt-in.
# components/muse_wakeword/README.md has the measurements behind these.
CONFIG_MUSE_WAKEWORD_ENABLE=y

# Inference speed over flash: the size-optimized runtime ran over the
# 20 ms frame budget on the BOX-3.
# CONFIG_ET_OPTIMIZE_SIZE is not set

# ExecuTorch's own logging off (about 91 KB of flash); et_model and runner
# errors still reach the console.
# CONFIG_ET_ENABLE_LOGGING is not set
