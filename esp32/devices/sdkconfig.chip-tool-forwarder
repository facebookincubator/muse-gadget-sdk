# The Matter forwarder (CONFIG_HOMEHUB_CHIP_TOOL_FORWARDER, the chip-tool-remote-forwarder
# component): load after the board's own overlay. Needs PSRAM, the home-network
# tunnel and 8 MB of flash.
CONFIG_HOMEHUB_CHIP_TOOL_FORWARDER=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_chip_tool_forwarder_8mb.csv"

# esp-matter's commissioner, no Matter server. Bluetooth commissioning shares
# NimBLE with the firmware's setup, which releases it once paired.
CONFIG_ENABLE_CHIP_CONTROLLER_BUILD=y
CONFIG_ESP_MATTER_CONTROLLER_ENABLE=y
CONFIG_ESP_MATTER_COMMISSIONER_ENABLE=y
CONFIG_ESP_MATTER_ENABLE_MATTER_SERVER=n
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_WIFI_NETWORK_COMMISSIONING_DRIVER=n
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
# The fabric's CA is chip-tool-remote's (the component's forwarder_ca.cpp).
CONFIG_CUSTOM_OPERATIONAL_CREDS_ISSUER=y

# Relative to esp32/: where the component manager puts the component
CONFIG_CHIP_PROJECT_CONFIG="managed_components/dhavalgujar__chip_tool_forwarder/CHIPProjectConfig.h"
CONFIG_CHIP_TASK_STACK_SIZE=15360
# CHIP's and lwIP's pools as the component needs them (its
# examples/forwarder/sdkconfig.defaults says why).
CONFIG_MAX_EXCHANGE_CONTEXTS=48
CONFIG_MAX_EVENT_QUEUE_SIZE=80
CONFIG_NUM_TIMERS=128
CONFIG_NUM_UDP_ENDPOINTS=16
CONFIG_LWIP_MAX_SOCKETS=16

# CHIP's data in the matter partition (partitions_chip_tool_forwarder_8mb.csv).
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_CONFIG_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_COUNTERS_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_KVS_NAMESPACE_PARTITION_LABEL="matter"

# IPv6 on the station; Thread devices through the home's border router (its
# route, learnt from router advertisements, through CHIP's route hook).
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_ENABLE_ROUTE_HOOK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# CHIP's, esp-matter's and NimBLE's allocations and static data in PSRAM
# (the component's linker.lf); internal RAM stays for Wi-Fi,
# the Link session and the tunnel.
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# ESP-IDF's GCM, not the fast GCM: its tables and staging buffer take internal
# RAM, which Matter and the Link session need.
CONFIG_HOMEHUB_FAST_GCM=n
# 8 Wi-Fi TX buffers, not ESP-IDF's 16: they take internal RAM (about
# 1.7 KB each), which Matter and the Link session need.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# lwIP's extra hot paths in flash: 16 KB more internal RAM.
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n

# The forwarder stream: TLS 1.2 ECDHE-PSK, keyed from the forwarder secret, with
# 4 KB records (the component's core/ctf_tls_mbedtls.cpp).
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_PSK=y
CONFIG_MBEDTLS_SSL_KEYING_MATERIAL_EXPORT=y
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y

# CHIP's own logs: errors only. At INFO it logs every message, which on a UART
# console holds up its thread long enough for its event queue to back up (set
# CHIP_LOG_DEFAULT_LEVEL_PROGRESS to debug). The relay's own lines still show
# (the component's core/ctf_log.h).
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y
