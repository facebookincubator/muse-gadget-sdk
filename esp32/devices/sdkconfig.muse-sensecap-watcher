# Seeed SenseCAP Watcher: 32 MB flash, 8 MB octal PSRAM.
# Load last, after sdkconfig.muse. Muse's partition table and NVS land on the
# Watcher's factory data (nvsfactory, 0x9000-0x3B000), so back that up before
# the first flash (see README.md).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_SENSECAP_WATCHER=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM: Wi-Fi's, lwIP's and BT's, and those marked
# EXT_RAM_BSS_ATTR (Muse's chat turn, the tunnel batch). Without it free
# internal RAM falls to 6 KB pieces and BLE setup can't start its 8 KB task,
# so the app's activation fails with "operation in progress".
# The board always has PSRAM, so booting without it needn't be allowed.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# That forces Wi-Fi's TX buffers static, in internal RAM: 8, not 16, at 1.6 KB
# each, which voice over the tunnel doesn't fill.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Screen off on battery: the CPU drops to the crystal clock and light-sleeps
# between button polls (muse_input.c). BLE has to allow that with modem sleep;
# there's no 32 kHz crystal, so its sleep clock is the main crystal, kept
# powered. On USB power the chip stays awake at full speed.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# The CPU stays powered in light sleep: saving its state takes 8.5 KB of
# internal RAM, more than Wi-Fi can spare here.
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# Pins keep their state in light sleep. This workaround would float them all,
# panel and touch reset and the amp enable included.
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
# For the battery meter (muse_battery.h, ">power" on the console): time
# actually slept, and how long each power lock kept the chip awake.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y

# Apps (muse_apps.c): big fonts for clocks and timers, and QR codes.
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_QRCODE=y

# The scripts' LittleFS buffers in PSRAM, not internal RAM.
CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM=y

# Long file names on the SD card (storage.*), their buffers on the heap.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# The RGB light (led.set) is one pixel, refreshed now and then: its RMT code
# can run from flash, leaving ~3 KB of internal RAM to Wi-Fi and BLE.
# CONFIG_RMT_ENCODER_FUNC_IN_IRAM is not set
# CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM is not set
# CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM is not set


# No core dump: its stacks would take ~4 KB of internal RAM. muse_crash.c
# keeps a crash's reason and backtrace in RTC memory instead.
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
