# Xteink X3: ESP32-C3 (single core, no PSRAM) with 16 MB flash, a 3.7 inch
# 792x528 black and white e-paper (UC8253, or UC8279d on units made after about
# July 2026) on SPI, and the chip's own USB-Serial-JTAG on a 4-pin magnetic
# cable. Load last, after sdkconfig.defaults (see README.md in this directory).
#
# Sources: the FreeInk SDK's XTEINK_X3 board profile
# (github.com/Free-Ink/freeink-sdk, libs/hardware/BoardConfig/include/BoardConfig.h)
# for the pins; CrossPoint Reader's platformio.ini for the chip and flash.
#
# It overrides the ESP32-C5 assumptions in sdkconfig.defaults; C5-only options
# there are ignored for this target.
CONFIG_IDF_TARGET="esp32c3"

# The e-paper shows a status screen, images and text messages.
CONFIG_HOMEHUB_LED_BACKEND_XTEINK_X3=y
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-X3"
# The power button, active low. The six page buttons are on two ADC ladders
# (GPIO1 and 2) and are not used.
CONFIG_HOMEHUB_BUTTON_GPIO=3

# UART0's default pins are GPIO20 (the I2C data line) and GPIO21 (the display's
# chip select), so the console must stay on USB.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# No PSRAM: same trims as the Waveshare C6 (sdkconfig.muse-waveshare-c6-18),
# which has more internal RAM than the C3.
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_HOMEHUB_TUNNEL=n

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15

# The C3 shares one 321 KB RAM between code placed in RAM for speed and the
# heap. sdkconfig.defaults puts about 80 KB of Wi-Fi, lwIP, Bluetooth and
# flash-driver code there for throughput. This board shows a still picture, so
# trade that speed for heap: with it in RAM the Muse session leaves 59 KB free
# and its buffers fail to allocate several times before they fit.
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_SPI_FLASH_ROM_IMPL=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# Fewer Wi-Fi receive buffers. The TCP windows stay at 16384: the build checks them.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
