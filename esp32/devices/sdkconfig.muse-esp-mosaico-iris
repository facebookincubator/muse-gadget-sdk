# ESP-Mosaico with Espressif's ESP-Iris (tools/muse/board.sh adds this when it
# finds esp-mosaico-utils, MOSAICO_UTILS). The board's retained Vibe Mode
# firmware installs apps over ESP-Iris on the USB-C port, and checks that the
# app it installs carries this product contract and answers ESP-Iris itself,
# so the next update can switch it back to Vibe Mode over USB. Values from
# esp-mosaico-recovery/components/esp_mosaico_app_recovery/sdkconfig.defaults
# and the Hello World template's sdkconfig.defaults.

CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v1"
CONFIG_ESP_IRIS_BOARD_ID="esp-mosaico"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-recovery-2m-v1"
CONFIG_ESP_IRIS_RECOVERY_ABI=1
CONFIG_ESP_IRIS_OTA_DEFAULT_VIA_RECOVERY=y
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y
# CONFIG_ESP_IRIS_OTA is not set

# ESP-Iris owns the high-speed USB; no TCP transport (installs go over USB).
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=n
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TRANSPORT_CLAIM_TIMEOUT_MS=2000
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
CONFIG_ESP_IRIS_LOG_RING_BYTES=4096
CONFIG_ESP_IRIS_LOG_RING_STORAGE_PSRAM=y
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Muse Gadget"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Panics go to the retained coredump partition, which Vibe Mode reads back.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
