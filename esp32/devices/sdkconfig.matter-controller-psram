# Matter on a board with PSRAM: load after devices/sdkconfig.matter-controller.
# Without it, CHIP's many small allocations stay in internal RAM
# (SPIRAM_MALLOC_ALWAYSINTERNAL keeps everything under 16 KB there), which the
# Link session, the tunnel and Wi-Fi need.
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
# CHIP's and esp-matter's static data (the commissioner, session and exchange
# pools) in PSRAM too (components/esp32_matter_controller/linker.lf). The
# firmware's own buffers marked EXT_RAM_BSS_ATTR move there as well.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
