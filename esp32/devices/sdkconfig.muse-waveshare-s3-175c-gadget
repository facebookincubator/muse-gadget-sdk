# The Waveshare S3 1.75C as a Muse Gadget (the catalog's W175, a reference
# Wi-Fi + BLE gadget). Load after devices/sdkconfig.muse-waveshare-s3-175c:
#   tools/muse/board.sh build s3-gadget
# The board's own overlay alone is the Wi-Fi Muse build the web flasher ships.

# musegadgets BLE audio (components/muse_gadget_ble): a phone, browser or
# gateway that connects over BLE and turns on push-to-talk gets the talk
# button's audio as SBC or LC3; otherwise it goes to Muse over Wi-Fi as
# before. Offline clips go to the mg_queue partition. The Muse app's BLE
# setup can skip Wi-Fi (token-only), and the app runs the token proof on
# every musegadgets connection.
CONFIG_MUSE_GADGET_BLE_AUDIO=y

# Advertises MuseGadget-W175-XXXXXX, XXXXXX the Bluetooth address's last
# three bytes.
CONFIG_HOMEHUB_BLE_PRODUCT_CODE="W175"
# link.register metadata.model_name: the product name.
CONFIG_HOMEHUB_MODEL_NAME="W175"

# The avatar face (main/mg_face.h): the home over the user's picture.
CONFIG_MUSE_AVATAR_FACE=y

# Internal RAM for Wi-Fi, BLE audio and the Muse session together (the
# heartbeat read 10 KB free, 0 KB at its lowest, before the session started):
# the avatar's, audio's, captions' and musegadgets' static buffers (about
# 30 KB) and the stacks of the app tasks that never map flash (about 26 KB,
# and the boot task's 8 KB until the UI is up; muse_stack.h) in PSRAM, as on
# the SenseCAP Watcher. Code runs from PSRAM here, so flash writes leave the
# cache on and those tasks may write NVS; mapping flash would still freeze
# it, so tasks that can (the musegadgets worker, OTA) stay internal.
CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM=y
CONFIG_MUSE_STACKS_IN_PSRAM=y

# Both watchdogs on, as on every BLE gadget profile (other builds keep
# sdkconfig.defaults', off): a hang restarts the gadget by itself. The
# windows are long so PSRAM cache stalls and busy decode stretches stay clear
# of them: the interrupt watchdog at 1.5 s, the task watchdog at 15 s on both
# idle tasks and the gadget watchdog's users (CONFIG_MUSE_GADGET_WDT,
# muse_wdt.h), each a panic with its crash record the boot guard counts.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1500
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# The boot guard (muse_bootguard.h): a crash loop ends in SAFE mode, where
# the BLE recovery tier stays up. On in the BLE gadget profiles only.
CONFIG_MUSE_BOOTGUARD=y
# ATT MTU exactly 247: a full 244-byte write is one 251-byte link-layer
# packet. A write split across packets was lost when the phone stalled
# between them (NimBLE's 30 s reassembly timeout).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Speaker volume until one is saved in Settings.
CONFIG_MUSE_DEFAULT_VOLUME=50
