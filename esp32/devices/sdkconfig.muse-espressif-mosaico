# Espressif ESP-Mosaico: ESP32-S31 (dual-core RISC-V) with 16 MB QIO flash and
# 16 MB octal PSRAM, 480x480 CO5300 touch AMOLED (CST9217), one ES8311 for the
# speaker and the microphone, BQ27220 fuel gauge. Buttons: AI (GPIO7, talk)
# and BOOT (GPIO61). The USB-C port is the chip's high-speed USB, not its USB
# Serial/JTAG.
# Sources: https://github.com/esp-mosaico/esp-mosaico-bsp for the pins
# (components/esp-mosaico-bsp/include/bsp/esp_mosaico.h), and the chip, flash
# and PSRAM settings of the ESP-Mosaico application template in
# https://github.com/esp-mosaico/esp-mosaico-utils
# (mosaico-tools/templates/hello_world/sdkconfig.defaults).
# The esp32s31 target is not in ESP-IDF v6.0.1; README.md in this directory
# says which ESP-IDF builds it, and how the board is installed.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_MUSE_BOARD_ESPRESSIF_MOSAICO=y
# The S31 defaults to 320 MHz; sdkconfig.defaults picks the C5's 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# Unused by Muse builds (the talk button confirms pairing). The AI button.
CONFIG_HOMEHUB_BUTTON_GPIO=7
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Nothing is wired to the chip's USB Serial/JTAG, so the log stays on UART0.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# PSRAM is required for the UI, images, voice session and tunnel. Octal, the
# only mode the S31 has, at the 250 MHz the ESP-Mosaico runs it. The quad and
# 80 MHz options in sdkconfig.defaults don't exist on this chip.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
