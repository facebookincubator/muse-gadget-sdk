# Espressif ESP32-S31-Korvo-1: ESP32-S31 (dual-core RISC-V), 16 MB flash,
# 16 MB octal PSRAM, ES8389 stereo codec, 4.3" RGB LCD daughterboard,
# OV3660 camera. Load last, after sdkconfig.muse. Requires ESP-IDF v6.1
# with preview targets (idf.py --preview). First bring-up is headless:
# audio + ADC buttons + WS2812; display and camera are deferred.
CONFIG_IDF_TARGET="esp32s31"
CONFIG_MUSE_BOARD_ESP32_S31_KORVO_1=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 16 MB flash uses the standard Muse partition table (partitions_muse.csv).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse.csv"
