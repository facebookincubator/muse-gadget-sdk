# DIAGNOSTIC ONLY. ESP32-S3, 32 MB flash (16 MB used), 8 MB octal PSRAM,
# CH343 UART bridge. Load after sdkconfig.defaults;devices/sdkconfig.muse;
# devices/sdkconfig.reterminal-sticky. Pins follow board_reterminal_sticky.c
# and Seeed factory_fw main/boards/reterminal_e1005.
CONFIG_MUSE_POWER_TEST=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=n
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
CONFIG_MUSE_STICKY_SD=n
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_HOMEHUB_SUPPORT_BUG_REPORT=n
