# Seeed reTerminal E1003 V1.0: ESP32-S3R8, 32 MB flash, 8 MB octal PSRAM,
# USB-UART bridge and 10.3 inch 1872x1404 ED103TC2 e-paper (IT8951 on SPI2).
# Sources: Seeed E1003 V1.0 schematic 202004522 and Seeed_GFX2's
# Driver_ED103TC2 / Driver_IT8951. Load after sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-reterminal-e1003"
CONFIG_MUSE_DEVICE_MODEL_NAME="Seeed reTerminal E1003"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# No status LED under firmware control that can show colours: the e-paper
# shows a status screen.
CONFIG_HOMEHUB_LED_BACKEND_RETERMINAL_IT8951=y
# Advertise as <prefix>-Disp-XXXXXX to tell this board apart from real devices:
# MuseGadget-Disp in the open-source build, HomeLink-Disp in the internal one.
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Disp"
# The green button on top, active low. The two white ones (GPIO4 and 5) are
# not used.
CONFIG_HOMEHUB_BUTTON_GPIO=3
CONFIG_HOMEHUB_BUTTON_LABEL="the green button"

# 32 MB flash, of which the first 16 MB are used: beyond that needs 32-bit
# flash addressing, and the partitions end at 4.3 MB.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Octal PSRAM holds the grayscale canvas and packed monochrome frames.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
# The BLE controller already takes ~70 KB of internal RAM on the S3; keep the
# NimBLE host's allocations in PSRAM so pairing has room.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
