# Seeed reSpeaker Flex with pre-soldered XIAO ESP32-S3 (-C4-1 or -L4-1),
# 8 MB flash and 8 MB octal PSRAM. Load after sdkconfig.defaults.
# Experimental Link-only voice. Requires the geometry-matched 16 kHz,
# two-channel I2S-slave image, baseline v1.0.4, with stock output routing.
# Sources: https://github.com/respeaker/reSpeaker_Flex and
# https://wiki.seeedstudio.com/respeaker_flex_xiao_i2s/
# XIAO BOOT=GPIO0, SDA=GPIO5, SCL=GPIO6, WS=GPIO7, BCLK=GPIO8,
# ESP32 DOUT=GPIO44, DIN=GPIO43. USB serial: Espressif 303a:1001.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_VOICE=y
CONFIG_HOMEHUB_VOICE_BOARD_RESPEAKER_FLEX=y
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-flex"
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
