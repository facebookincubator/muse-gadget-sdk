# FoloToy AI Passport: ESP32-C3 (single core, 8 MB flash, no PSRAM), 240x320
# ST7789P3 LCD on SPI2, ES8311 codec, three keys on one ADC resistor ladder, a
# CW2017 fuel gauge, native USB (USB Serial/JTAG). Pins and bus settings are
# FoloToy's BSP's (github.com/FoloToy/ai-passport, components/bsp/include/
# bsp_pins.h); boards/board_ai_passport.c has the details.
#
# Load last, after sdkconfig.muse. Without PSRAM Muse has no Hatch session of
# its own (MUSE_HATCH defaults off): voice notes go over Link's session and
# replies come back as text, and images can't be shown. Link's TLS, Wi-Fi and
# BLE buffers are trimmed to fit internal RAM, the same knobs as the other
# no-PSRAM boards (see sdkconfig.c6-nopsram and sdkconfig.muse-waveshare-c6-18).
CONFIG_IDF_TARGET="esp32c3"
CONFIG_MUSE_BOARD_AI_PASSPORT=y

# The console is the chip's own USB Serial/JTAG, as in FoloToy's firmware:
# UART0's default TX is GPIO21, which this board uses for the LCD backlight.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 8 MB of flash, and the layout the full UI's two OTA slots need (the other
# 8 MB boards use it too). DIO: FoloToy's firmware doesn't ask the flash for QIO.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_SPIRAM=n
# TLS: keep allocations in internal SRAM and shrink outbound records; dynamic
# input buffers are sized to each record instead of a fixed 16 KB. Without the
# dynamic buffers the fixed 16 KB one doesn't fit beside the display's DMA
# buffers and the BLE pools.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# The home-network tunnel and discovery need ~60 KB more internal RAM than the
# control session; without them the device still pairs and Muse reaches it.
CONFIG_HOMEHUB_TUNNEL=n

# Fewer Wi-Fi TX buffers and lwIP mailboxes than the S3 boards, and half the
# RX buffers: the control session carries text and voice notes, not large
# downloads, and internal RAM here has to hold Muse's UI as well.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# One phone at a time: half the NimBLE pools gives the pairing TLS handshake
# back ~9 KB, and the controller only ever runs one advertisement and one
# connection (an activity is 828 bytes).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=4
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=6
CONFIG_BT_CTRL_BLE_MAX_ACT=2

# One core: LVGL's software renderer keeps to a single draw unit.
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# The two/three-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y

# Sleeping: the keys' ladder has its own 10 k pull-up, and the internal ones
# (~45 k) would squeeze all three steps into the bottom of the ADC's range
# (the same reason components/bsp/include/bsp_pins.h forbids them there).
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=n
