# FoloToy AI Passport: ESP32-C3 (single core, 400 KB SRAM), 8 MB embedded
# flash in DIO mode, no PSRAM. Load last, after sdkconfig.muse. As on the
# Waveshare C6 there is no Hatch session: voice notes go over Link's session
# and replies show as text. The C3 has ~110 KB less SRAM than the C6, so
# Link's TLS, Wi-Fi and BLE buffers are trimmed at least as hard.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_MUSE_BOARD_AI_PASSPORT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Two-button-style menu on a small screen.
CONFIG_LV_FONT_MONTSERRAT_12=y
# Muse often answers in Chinese; the fallback font lives in flash, not RAM.
CONFIG_MUSE_CJK_FONT=y

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
# An update's download would need RAM the session already uses; untested here.
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_HOMEHUB_TUNNEL=n

CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15

# On the C3, IRAM and DRAM are the same 400 KB of SRAM, so every function kept
# in IRAM is heap the UI, Wi-Fi and BLE don't get. Nothing here has to run
# while the flash cache is off: the LCD, codec and gauge just wait out NVS
# writes. Together this moves ~45 KB of code to flash.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_GDMA_CTRL_FUNC_IN_IRAM=n
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_LIBC_MISC_IN_IRAM=n
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n

# BLE is only for pairing and phone setup: one advertiser and one connection,
# no scanning, no BLE 5 extended advertising, no test mode.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=8
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=8

# Fewer preallocated Wi-Fi receive buffers; the dynamic ones grow on demand.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
# The block-ack window may be at most twice the static buffers.
CONFIG_ESP_WIFI_RX_BA_WIN=6

# LVGL's draw thread, and its layer buffer: drawn in slices instead of
# grabbing 24 KB at once whenever a widget fades (4 KB slices).
CONFIG_LV_DRAW_THREAD_STACK_SIZE=5120
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=4096
# Bound chat RX/TX bursts so TCP and Wi-Fi leave room for TLS records and the
# UI while a voice note uploads, as the Cardputer ADV does: four-MSS TCP
# windows (validate_config.cmake allows them on this board).
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
