# ESP32-C3 board with a 0.42 inch 72x40 SSD1306 OLED (I2C, SDA GPIO5, SCL
# GPIO6), 4 MB in-package flash, no PSRAM, native USB Serial/JTAG. A status
# screen board, without the full UI: the OLED shows the status and the
# agent's name as text. Load last, after sdkconfig.defaults (see README.md in
# this directory). The defaults are tuned for the ESP32-C5; options the C3
# lacks are ignored.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

CONFIG_HOMEHUB_LED_BACKEND_C3_SSD1306=y
# Advertises as MuseGadget-Oled-XXXXXX.
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Oled"
# BOOT button, active low.
CONFIG_HOMEHUB_BUTTON_GPIO=9

# 4 MB flash: one app slot, no OTA (partitions.csv needs 8 MB).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c3_4mb.csv"

# No PSRAM. mbedtls and every PSRAM-preferred buffer fall back to internal RAM.
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# 16 KB TLS records in both directions would cost 32 KB of internal RAM per
# connection. Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# The home-network tunnel needs more internal RAM than the C3 has to spare.
CONFIG_HOMEHUB_TUNNEL=n

# NimBLE: no L2CAP channels; pairing uses GATT only.
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0

# USB Serial/JTAG console (no UART bridge on this board).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
