# ESP32-C3 development board with 0.42 inch 72x40 SSD1306 OLED display,
# 4 MB in-package flash, USB-C direct to SoC. Load last, after
# sdkconfig.defaults (see README.md in this directory).
#
# This is a bench profile for the ESP32-C3 (RISC-V single core, 2.4 GHz
# Wi-Fi, BLE 5, no PSRAM). It overrides the ESP32-C5 assumptions in
# sdkconfig.defaults; C5-only options there are ignored for this target.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y

# Monochrome text status display on the 72x40 SSD1306 OLED.
CONFIG_HOMEHUB_LED_BACKEND_C3_SSD1306=y
# Advertise as <prefix>-Oled-XXXXXX to tell this board apart:
# MuseGadget-Oled in the open-source build, HomeLink-Oled in the internal one.
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Oled"
# BOOT button, active low.
CONFIG_HOMEHUB_BUTTON_GPIO=9

# 4 MB flash, single factory partition (no OTA). DIO is the safe mode.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# No PSRAM. mbedtls and every PSRAM-preferred buffer fall back to internal RAM.
CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# 16 KB TLS records in both directions would cost 32 KB of internal RAM per
# connection. Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# BLE-only: disable Bluetooth Classic to save RAM.
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Trim NimBLE pools for the no-PSRAM C3 (same as C6/CYD pattern).
CONFIG_BT_NIMBLE_HS_FLOW_CTRL_TX_ON_DISCONNECT=y
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0

# No tunnel: the control session carries only JSON, so the small session
# buffers apply (see noise_control.cpp SMALL_CONTROL_SESSION).
CONFIG_HOMEHUB_TUNNEL=n

# The C3 has no 32kHz crystal; use the internal RC for RTC slow clock.
CONFIG_ESP32C3_RTC_CLK_SRC_INT_RC=y

# USB Serial/JTAG console (no UART bridge on this board).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_c3_4mb.csv"
