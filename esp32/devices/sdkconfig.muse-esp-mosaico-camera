# The Camera Module in the ESP-Mosaico's left expansion slot, for
# camera.capture. Load after devices/sdkconfig.muse-esp-mosaico
# (MUSE_CAMERA=1 tools/muse/board.sh build mosaico). Its two sensors at the
# UYVY sizes Espressif's mosaico_module_camera picks for them; the SC101IOT at
# 15 fps, esp_cam_sensor's default for it.
CONFIG_MUSE_MOSAICO_CAMERA=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV3640=y
CONFIG_CAMERA_OV3640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3640_DVP_YUV422_UYVY_1024X768_25FPS=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_1024X768_25FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_15FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_1280X720_15FPS=y
