# M5Stack CoreS3: ESP32-S3 with 16 MB QSPI flash and 8 MB quad PSRAM,
# 2" 320x240 ILI9342C touch LCD (FT6336U), AW88298 speaker amp and ES7210
# microphones, AXP2101 PMU and AW9523B IO expander.
# Native USB Serial/JTAG (303a:1001). No user button: PWR (on the AXP2101) talks.
# Sources: https://github.com/espressif/esp-bsp/tree/master/bsp/m5stack_core_s3,
# https://docs.m5stack.com/en/core/CoreS3; esptool flash-id on the board for
# the flash, and the PSRAM probe at boot for its size and mode.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_M5STACK_CORES3=y
# The AW88298 and 1 W speaker are quiet at the usual 70%.
CONFIG_MUSE_DEFAULT_VOLUME=100
# Unused by Muse builds (the talk button confirms pairing); GPIO0 is I2S MCLK here.
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM is required for the UI, images, voice session and tunnel. Quad, unlike
# the BOX-3's octal part.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# Keep the BSP's SPI transfer allocation and our LVGL buffers small.
CONFIG_BSP_LCD_DRAW_BUF_HEIGHT=10
CONFIG_BSP_LCD_DRAW_BUF_DOUBLE=y
