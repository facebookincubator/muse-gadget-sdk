# HID over GATT beside musegadgets (protocols/UI.md, UI input): the gadget
# as a Bluetooth touchscreen / pointer (HOGP). Load after
# devices/sdkconfig.muse-video-ble: MUSE_HID=1 tools/muse/board.sh build
# stopwatch-video. It turns on NimBLE's security manager with bonding, and a
# phone that bonds then expects an encrypted link: unpair the gadget in the
# phone's Bluetooth settings before going back to a build without it.
CONFIG_MUSE_GADGET_BLE_HID=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
# Bonding runs on the NimBLE host task: storing the keys (NVS writes, the
# key structs) and the companions' event handlers with their logging. The
# 4 KB default overflowed there with an iPhone (a bond, then reconnects that
# failed encryption): 8 KB (mg.hid logs the task's lowest free stack).
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# A bonded phone keeps ~10 subscriptions (the HID reports, musegadgets,
# Battery, the log mirror, Service Changed): room for every bond's.
CONFIG_BT_NIMBLE_MAX_CCCDS=40
