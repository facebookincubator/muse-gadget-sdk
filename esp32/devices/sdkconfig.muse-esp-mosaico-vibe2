# ESP-Mosaico with Vibe Mode 0.2, loaded after the -iris overlay
# (tools/muse/board.sh adds it for an esp-mosaico-utils checkout that has
# esp-mosaico-vibe-mode). A 0.2 board's Vibe Mode takes only apps that
# answer ESP-Iris with this contract, whose values are in
# esp-mosaico-vibe-mode/components/esp_mosaico_app_recovery/sdkconfig.defaults.

CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v2"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-test-2m-v2"
CONFIG_ESP_IRIS_RECOVERY_ABI=2
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_mosaico_vibe2.csv"
# ESP-Iris 0.2 runs its data link on a second CDC interface.
CONFIG_TINYUSB_CDC_COUNT=2
