# ALIENTEK ATK-DNESP32S3-BOX2 (Wi-Fi), not the V1.1 box: ESP32-S3 with 16 MB
# flash and 8 MB octal PSRAM, native USB Serial/JTAG (303a:1001), 240x320
# ST7789 on an 8-bit i80 bus run as 320x240 landscape, ES8389 codec, keys L,
# M and Q (XL9555) and R (GPIO0), a battery, no touch. Pins: xiaozhi-esp32's
# alientek/atk-dnesp32s3-box2-wifi board, which builds with xiaozhi's S3
# defaults (16 MB flash, octal PSRAM). Load last, after sdkconfig.muse.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-atk-dnesp32s3-box2"
CONFIG_MUSE_DEVICE_MODEL_NAME="ALIENTEK ATK-DNESP32S3-BOX2"
CONFIG_MUSE_BOARD_ATK_DNESP32S3_BOX2=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Static buffers in PSRAM, as on the V1.1 box: without it BLE setup can't
# find the internal RAM for its task. The module always has PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# The avatar's and audio's static buffers too (about 17 KB): only the CPU
# touches them, and Link and Muse's sessions need the internal RAM.
CONFIG_MUSE_STATIC_BUFFERS_IN_PSRAM=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Two-key menu.
CONFIG_LV_FONT_MONTSERRAT_12=y
# Sold mostly to Chinese speakers: captions fall back to Unifont's CJK
# (about 1.2 MB) instead of showing boxes.
CONFIG_MUSE_CJK_FONT=y
