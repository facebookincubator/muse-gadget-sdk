# Waveshare ESP32-C6-Touch-AMOLED-1.8: single core, 16 MB flash, no PSRAM.
# Load last, after sdkconfig.muse. Without PSRAM Muse has no voice session of
# its own (MUSE_HATCH defaults off): voice notes go over Link's session and
# replies show as text. Link's TLS, Wi-Fi and BLE buffers are trimmed to fit
# internal RAM.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-waveshare-c6-18"
CONFIG_MUSE_DEVICE_MODEL_NAME="Waveshare ESP32-C6-Touch-AMOLED-1.8"
CONFIG_MUSE_BOARD_WAVESHARE_C6_18=y
# The UI's type drawn at this panel's size (fonts/type, 368 px).
CONFIG_MUSE_UI_PANEL_TYPE=y

# Muse Gadgets catalog model code: advertises
# MuseGadget-WC6-XXXXXX. ESP32 catalog boards keep the Wi-Fi MAC tail, the
# same digits as before the code. The BLE-only
# c6ble profile loads after this overlay and keeps it.
CONFIG_HOMEHUB_BLE_PRODUCT_CODE="WC6"
# link.register metadata.model_name: the product name.
CONFIG_HOMEHUB_MODEL_NAME="C6"
CONFIG_HOMEHUB_BLE_NAME_TAIL_WIFI_MAC=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Room for every circle radius on screen at once (the bezel ring's two, the
# settings cards', the icons'): with the default 4 they evict each other and
# the 180 px ring's mask tables are rebuilt for every strip it crosses.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16

# Touch: read at 400 kHz, like the PMU on the same bus (the BSP's default is
# 100 kHz), and only the one point the UI uses.
CONFIG_BSP_I2C_CLK_SPEED_HZ=400000
CONFIG_ESP_LCD_TOUCH_MAX_POINTS=1

CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# With BLE up during pairing the largest free block is ~14 KB, too small for
# the fixed 16 KB input buffer. Dynamic buffers are sized to each record and
# freed after the handshake. (The fragmentation that keeps them off elsewhere
# is about PSRAM routing, and there is none here.)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# The home-network tunnel and discovery need ~60 KB more internal RAM than the
# control session; without them the status turns green once that is up.
CONFIG_HOMEHUB_TUNNEL=n

# Fewer Wi-Fi TX buffers and lwIP mailboxes than the S3 boards.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# One phone at a time, a handful of notifications in flight: half the NimBLE
# pools gives the pairing TLS handshake back ~9 KB.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
# Link policy: the C6 controller has no live
# peripheral-latency switch, so latency is renegotiated (mg_linkpol.h); this
# makes it at least keep listening at the next event after a received data
# packet instead of going back to skipping events.
CONFIG_BT_LE_CTRL_SLV_FAST_RX_CONN_DATA_EN=y

# On the C6, IRAM and DRAM share SRAM, so code kept in IRAM is heap the voice
# upload doesn't get. Move driver ISRs, the heap and the BLE controller to
# flash (the SPI master ISR follows the heap). None of these driver
# interrupts is cache-safe on this board, so they already waited out NVS and
# OTA flash writes; the BLE controller's now does too. A driver's cache-safe
# option still puts its handler back in IRAM.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
