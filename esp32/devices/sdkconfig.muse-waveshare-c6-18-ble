# Waveshare ESP32-C6-Touch-AMOLED-1.8 as a BLE-only musegadgets gadget: load
# after sdkconfig.muse and sdkconfig.muse-waveshare-c6-18. Wi-Fi, the Muse
# session, the tunnel and OTA never start, which frees the internal RAM that
# kept musegadgets BLE audio off this PSRAM-less board. The Muse app sets it
# up over Home Link's BLE setup without Wi-Fi (token-only, confirmed with the
# talk button). The talk button's audio goes to the Muse app over BLE, or to
# the offline queue while no app is connected. tools/muse/board.sh builds it
# as "c6ble".
CONFIG_MUSE_GADGET_BLE_AUDIO=y
CONFIG_MUSE_GADGET_BLE_STANDALONE=y
# SBC and LC3: the fixed-point LC3 (lc3fx, the
# default on this FPU-less RISC-V core), the whole codec in internal RAM:
# from flash the cache it shares with the BLE stack makes it about 2 times
# slower (measured on this board: encode 544 us, decode 287 us per 10 ms
# frame in RAM; 1244 / 611 us from flash).
CONFIG_MUSE_GADGET_BLE_LC3=y
CONFIG_MUSE_GADGET_BLE_LC3_FIXED=y
CONFIG_MUSE_GADGET_BLE_LC3_PLACE_RAM=y
CONFIG_MUSE_GADGET_BLE_QUEUE=y

# Nothing updates it over the air.
CONFIG_HOMEHUB_OTA_ENABLED=n

# The Wi-Fi and lwIP hot paths in IRAM would only take RAM here.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=n

# Audio streams a notification every 20 ms, so give NimBLE back the pool
# blocks the Wi-Fi board overlay took for the pairing TLS handshake.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=30

# Both watchdogs on, as on every BLE gadget profile (other boards keep
# sdkconfig.defaults', off): a hang restarts the gadget by itself. The
# windows are long so PSRAM cache stalls and busy decode stretches stay clear
# of them: the interrupt watchdog at 1.5 s, the task watchdog at 15 s on both
# idle tasks and the gadget watchdog's users (CONFIG_MUSE_GADGET_WDT,
# muse_wdt.h), each a panic with its crash record the boot guard counts.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1500
CONFIG_ESP_INT_WDT_CHECK_CPU1=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
# The boot guard (muse_bootguard.h): a crash loop ends in SAFE mode, where
# the BLE recovery tier stays up. On in the BLE gadget profiles only.
CONFIG_MUSE_BOOTGUARD=y
# ATT MTU exactly 247: a full 244-byte write is one 251-byte link-layer
# packet. A write split across packets was lost when the phone stalled
# between them (NimBLE's 30 s reassembly timeout).
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# Speaker volume until one is saved in Settings.
CONFIG_MUSE_DEFAULT_VOLUME=50
