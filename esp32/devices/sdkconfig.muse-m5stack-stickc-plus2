# M5Stack StickC Plus2: ESP32-PICO-V3-02 (classic ESP32, 8 MB flash, 2 MB
# quad PSRAM), three buttons, no touch, console on a CH9102 USB-UART bridge.
# Load last, after sdkconfig.muse.
CONFIG_IDF_TARGET="esp32"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-m5stack-stickc-plus2"
CONFIG_MUSE_DEVICE_MODEL_NAME="M5Stack StickC Plus2"
CONFIG_MUSE_BOARD_M5STACK_STICKC_PLUS2=y
# Signed apps without Secure Boot use the Secure Boot V2 (RSA) scheme, which
# the ESP32 supports from chip revision 3.0 (the PICO-V3 is one).
CONFIG_ESP32_REV_MIN_3=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_SPIRAM=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# Muse's voice task keeps its stack in PSRAM. Off by default on the ESP32 for
# the revision 1 PSRAM cache bug, which revision 3 (above) doesn't have.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Release the classic Bluetooth controller memory; pairing is BLE only.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Two-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y
