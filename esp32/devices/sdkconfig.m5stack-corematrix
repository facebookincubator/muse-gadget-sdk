# M5Stack CoreMatrix (C158): ESP32-C61HR8, 16 MB flash, 8 MB quad PSRAM,
# native USB. Link's status and Muse's images show on its 16x16 white LED
# matrix (main/matrix_status.c) and BtnA (KEY1) is the setup button, both
# through I2C chips (components/m5stack_corematrix).
# https://docs.m5stack.com/en/core/CoreMatrix
# Load last, after sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32c61"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-m5stack-corematrix"
CONFIG_MUSE_DEVICE_MODEL_NAME="M5Stack CoreMatrix"
CONFIG_MUSE_DEVICE_GUIDE="devices/guides/corematrix.md"
CONFIG_HOMEHUB_LED_BACKEND_M5_COREMATRIX=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
