# Deotaland RoRoLee (RRL-01): ESP32-S3 with 16 MB flash and 8 MB octal PSRAM,
# a 120x240 SH8501 AMOLED on SPI (no touch) that the UI draws in landscape,
# an ES8311 speaker codec and an ES7210 microphone ADC on one duplex I2S bus,
# a BQ27220 fuel gauge, three buttons (BOOT, VOL+, VOL-) and a vibration motor.
# Native USB Serial/JTAG (303a:1001). Load last, after sdkconfig.muse.
# Pins are from Deotaland's RRL-01 schematic and production firmware; see
# components/muse/boards/board_deotaland_rorolee.c.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_DEOTALAND_ROROLEE=y
# BOOT; the talk button confirms pairing, so Link doesn't read it itself.
CONFIG_HOMEHUB_BUTTON_GPIO=0
# The production firmware runs the flash in DIO.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# As on the AIPI: static buffers in PSRAM, or BLE setup can't find 8 KB of
# internal RAM for its task.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y
# Replies are mostly Chinese.
CONFIG_MUSE_CJK_FONT=y

# Screen off on battery: light sleep between button presses, as on the AIPI
# (see sdkconfig.muse-aipi). The board's 32 kHz crystal (GPIO 15 and 16) is
# left unused, so BLE sleeps on the main crystal, kept powered.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
