# Waveshare ESP32-S3-Touch-LCD-1.85B, ESP32-S3. Load after sdkconfig.muse.
# Pin map/display sequence are from the project's vendor-reference setup_device.c;
# flash/PSRAM sizing must be confirmed against the exact module revision.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_WAVESHARE_S3_185B=y
CONFIG_MUSE_BOARD_ID="waveshare_s3_185b"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_LV_USE_QRCODE=y
# 字幕/回复走上游的 caption_font()（unscii-16 + CJK 回退），本板界面是中文，
# 必须开这个，否则字幕里的汉字会变成方框。
CONFIG_MUSE_CJK_FONT=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
