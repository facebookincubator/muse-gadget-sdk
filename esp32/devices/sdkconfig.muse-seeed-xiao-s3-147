# Seeed XIAO ESP32-S3 Plus + 1.47-inch JD9853A touch display.
# ESP32-S3R8: 16 MB flash, 8 MB octal PSRAM; native USB 303a:1001.
# Load after sdkconfig.defaults and devices/sdkconfig.muse.
# Sources: Seeed wiki /getting_started_1.47_inch_touch_display_esp32s3/
# and Seeed-Studio/Seeed_GFX2 (panel, touch and PDM examples).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_SEEED_XIAO_S3_147=y
CONFIG_HOMEHUB_BUTTON_GPIO=11
# UART0 defaults overlap SD CS (GPIO43) and touch IRQ (GPIO44). Route the
# primary console and ESP_LOG diagnostics to the board's native USB instead.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_MUSE_CJK_FONT=y
# PDM microphone only: the board has no speaker. No battery/IMU/SD yet.
# Use local reflashing while this new board profile is being validated.
CONFIG_HOMEHUB_OTA_ENABLED=n
