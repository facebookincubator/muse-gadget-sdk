# The phone camera over Wi-Fi, for any board with the full UI whose panel
# driver has draw_frame (the Waveshare S3 1.75C and 1.75, the StopWatch, the
# ESP-Mosaico), loaded after its own overlay:
#   MUSE_VIDEO=1 tools/muse/board.sh build|flash <board>
# protocols/VIDEO.md has the design and the numbers.
CONFIG_MUSE_VIDEO=y
CONFIG_MUSE_VIDEO_WIFI=y

# Per-task CPU time on the decoder's stats line (what's left for voice).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# mDNS (the phone finds the board with it): its task and buffers in PSRAM,
# which internal RAM, held by Wi-Fi, BLE and the UI, can't spare. Station only.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
