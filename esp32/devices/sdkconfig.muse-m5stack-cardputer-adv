# M5Stack Cardputer ADV: ESP32-S3FN8, 8 MB flash, no PSRAM, native USB.
# Load after sdkconfig.defaults and sdkconfig.muse.
# Pins and panel geometry: M5Stack M5Unified, M5GFX and M5Cardputer sources;
# see components/muse/boards/board_m5stack_cardputer_adv.c.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_DEVICE_MODEL_ID="muse-gadget-m5stack-cardputer-adv"
CONFIG_MUSE_DEVICE_MODEL_NAME="M5Stack Cardputer ADV"
CONFIG_MUSE_BOARD_M5STACK_CARDPUTER_ADV=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_MUSE_HATCH=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1

CONFIG_SPIRAM=n
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=n
# Servers may still send 16 KB records, so only shrink outbound.
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# With BLE up during pairing the largest free block is ~14 KB, too small for
# the fixed 16 KB input buffer. Dynamic buffers are sized to each record and
# freed after the handshake. (The fragmentation that keeps them off elsewhere
# is about PSRAM routing, and there is none here.)
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# The home-network tunnel and discovery need ~60 KB more internal RAM than the
# control session; without them the status turns green once that is up.
CONFIG_HOMEHUB_TUNNEL=n

# Bound concurrent chat RX/TX bursts so TCP/Wi-Fi leave room for TLS records.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# One phone at a time, a handful of notifications in flight: half the NimBLE
# pools gives the pairing TLS handshake back ~9 KB.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=12
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=15
