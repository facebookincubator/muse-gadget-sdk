# The cable mirror (components/muse_mirror, docs/mirror.md), for any board
# with the full LVGL UI and PSRAM, loaded after its own overlay:
#   MUSE_MIRROR=1 tools/muse/board.sh build|flash <board>
CONFIG_MUSE_MIRROR=y
