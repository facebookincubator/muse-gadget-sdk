FROM muse-ma35-board-sim:local
COPY chat.py cli.py link_client.py service.py /tmp/muse-chat/
RUN python -c "from pathlib import Path; import shutil, musegadget; target=Path(musegadget.__file__).parent; [shutil.copyfile(p, target/p.name) for p in Path('/tmp/muse-chat').glob('*.py')]"
