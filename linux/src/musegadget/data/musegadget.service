# Keeps the device connected to its Muse. Runs as root (Bluetooth, device
# credentials); commands run as MUSEGADGET_RUN_AS, which the installer sets
# to the account that installed the device.

[Unit]
Description=Muse Home Link (Linux Device SDK)
Wants=network-online.target
After=network-online.target bluetooth.target

[Service]
Environment=PYTHONUNBUFFERED=1
Environment=MUSEGADGET_RUN_AS=@RUN_AS@
ExecStart=/opt/musegadget/venv/bin/musegadget run
RuntimeDirectory=musegadget
RuntimeDirectoryMode=0755
StateDirectory=musegadget
StateDirectoryMode=0700
Restart=always
RestartSec=5
# Exit 78: the trust store needs fixing first. Restart musegadget once it is.
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
